---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Faq from "../components/Faq.astro";
import PackageCard from "../components/PackageCard.astro";
import KelasBand from "../components/KelasBand.astro";
import { Image } from "astro:assets";
import { photo } from "../data/images";
import { packagesFor, needsFor, woStepsFor, guestRangesFor, budgetsFor } from "../data/packages";
import { woFaqFor } from "../data/content";
import { WA, waLink, woGreeting } from "../data/site";
import { langOf, path } from "../i18n/lang";
import { ui } from "../i18n/ui";

const lang = langOf(Astro.url);
const u = ui(lang);
const PACKAGES = packagesFor(lang);
const wa = waLink(WA.wo.number, woGreeting(lang));
const chips = needsFor(lang).filter((n) => n.id !== "tempat");
const COPY = {
  id: {
    title: "Layanan pernikahan syar'i | Mahabbati",
    desc: "Pilih paket khitbah, akad, akad di masjid, walimah, paket lengkap, atau koordinasi hari H. Bandingkan harga mulai dan jumlah tamu.",
    h1: "Layanan pernikahan.",
    lead: "Pesan satu acara, atau serahkan semuanya kepada kami. Setiap paket bisa kamu hitung estimasinya sesuai jumlah tamu.",
    heroImg: "Pelaminan berhias bunga merah dan putih dengan kursi pengantin berukir emas.",
    listTitle: "Daftar paket",
    needLegend: "Kebutuhan",
    all: "Semua",
    venueOnly: "Tempat saja",
    guests: "Tamu",
    budget: "Budget",
    apply: "Terapkan",
    count: "{n} paket",
    one: "1 paket",
    none: "Tidak ada paket",
    emptyTitle: "Belum ada paket yang cocok dengan pilihan ini.",
    emptyBody: "Ceritakan kebutuhanmu ke tim WO, kami bantu susunkan paketnya.",
    showAll: "Tampilkan semua paket",
    ask: "Tanya tim WO",
    kTitle: "Kelas pranikah, sudah termasuk.",
    kLead: "Paket Akad, Akad di Masjid, dan Paket Lengkap memberi akses kelas pranikah dan nasihat pernikahan dari asatidz Mahabbati, langsung di aplikasi.",
    kCta: "Lihat isi kelasnya",
    flowTitle: "Dari obrolan pertama sampai hari H.",
    faqTitle: "Tanya jawab.",
    faqLead: "Kirim tanggal, kota, dan perkiraan jumlah tamu. Tim WO membalas lewat WhatsApp.",
    chat: "Chat tim WO,",
  },
  en: {
    title: "Islamic wedding services | Mahabbati",
    desc: "Choose a khitbah, akad, mosque akad, walimah or full wedding package, or wedding-day coordination. Compare starting prices and guest counts.",
    h1: "Wedding services.",
    lead: "Book a single event, or hand the whole wedding over to us. Every package comes with an estimate for your guest count.",
    heroImg: "A wedding stage with red and white flowers and gold-carved chairs.",
    listTitle: "Packages",
    needLegend: "What you need",
    all: "All",
    venueOnly: "Venue only",
    guests: "Guests",
    budget: "Budget",
    apply: "Apply",
    count: "{n} packages",
    one: "1 package",
    none: "No packages",
    emptyTitle: "No package matches these choices yet.",
    emptyBody: "Tell the WO team what you need, and we'll put a package together for you.",
    showAll: "Show all packages",
    ask: "Ask the WO team",
    kTitle: "The pre-marriage class, included.",
    kLead: "The Akad Package, Akad at a Mosque and the full wedding packages include the pre-marriage class and marriage advice from the asatidz of Mahabbati, in the app.",
    kCta: "See what's in the class",
    flowTitle: "From the first chat to the wedding day.",
    faqTitle: "Questions and answers.",
    faqLead: "Send us your date, city and expected guests. The WO team replies on WhatsApp.",
    chat: "Chat with the WO team,",
  },
};
const c = COPY[lang];
const service = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Wedding Organizer Mahabbati",
  serviceType: "Wedding organizer syar'i",
  provider: { "@type": "Organization", name: "Mahabbati" },
  offers: PACKAGES.filter((p) => !p.placeholder).map((p) => ({ "@type": "Offer", name: p.name, priceCurrency: "IDR", price: p.priceFrom })),
};
---

<Base
  title={c.title}
  description={c.desc}
  current="layanan"
  ogImage="n-stage"
  jsonLd={[service]}
>
  <section class="cat-hero wrap" aria-labelledby="cat-title">
    <div>
      <h1 id="cat-title" class="t-display">{c.h1}</h1>
      <p class="t-lead">{c.lead}</p>
    </div>
    <figure class="cat-hero__photo photo">
      <Image src={photo("n-stage")} alt={c.heroImg} widths={[480, 720, 960]} sizes="(max-width: 900px) 92vw, 30vw" loading="eager" />
    </figure>
  </section>

  <section class="cat section" aria-labelledby="cat-results-title">
    <div class="wrap">
      <h2 id="cat-results-title" class="visually-hidden">{c.listTitle}</h2>
      <form class="filters" data-catalog-form action={path(lang, "layanan")} method="get">
        <fieldset class="filters__needs">
          <legend class="visually-hidden">{c.needLegend}</legend>
          <label class="fchip">
            <input type="radio" name="kebutuhan" value="" checked />
            <span>{c.all}</span>
          </label>
          {
            chips.map((n) => (
              <label class="fchip">
                <input type="radio" name="kebutuhan" value={n.id} />
                <span>{n.label}</span>
              </label>
            ))
          }
          <a class="fchip fchip--link" href={path(lang, "tempat")}><span>{c.venueOnly} <Icon name="arrow_outward" size={16} /></span></a>
        </fieldset>
        <div class="filters__selects">
          <label>
            <span>{c.guests}</span>
            <select name="tamu">
              <option value="">{c.all}</option>
              {guestRangesFor(lang).map((g) => <option value={g.id}>{g.label}</option>)}
            </select>
          </label>
          <label>
            <span>{c.budget}</span>
            <select name="budget">
              <option value="">{c.all}</option>
              {budgetsFor(lang).map((b) => <option value={b.id}>{b.label}</option>)}
            </select>
          </label>
          <noscript><button class="btn" type="submit">{c.apply}</button></noscript>
        </div>
      </form>

      <p class="cat__count" role="status" data-catalog-count data-tpl={c.count} data-one={c.one} data-none={c.none}>{c.count.replace("{n}", String(PACKAGES.length))}</p>

      <ul class="cat__grid" data-catalog>
        {
          PACKAGES.map((p) => (
            <li data-catalog-item>
              <PackageCard pkg={p} headingLevel="h3" />
            </li>
          ))
        }
      </ul>
      <div class="cat__empty" data-catalog-empty hidden>
        <p class="t-h3">{c.emptyTitle}</p>
        <p>{c.emptyBody}</p>
        <div class="cat__empty-actions">
          <button class="btn btn--outline" type="button" data-catalog-reset>{c.showAll}</button>
          <a class="btn btn--wa" href={wa} rel="noopener" data-track="wa:catalog-empty"><Icon name="whatsapp" size={20} />{c.ask}</a>
        </div>
      </div>
    </div>
  </section>

  <KelasBand
    id="kelas-title"
    title={c.kTitle}
    lead={c.kLead}
    cta={c.kCta}
  />

  <section class="flow section" aria-labelledby="flow-title">
    <div class="wrap flow__grid">
      <h2 id="flow-title" class="t-h2">{c.flowTitle}</h2>
      <ol class="flow__list">
        {
          woStepsFor(lang).map((s, i) => (
            <li class="flow__step" data-reveal style={`--d:${i * 80}`}>
              <span class="flow__num num" aria-hidden="true">
                {i + 1}
              </span>
              <h3 class="t-h3">{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="wo-faq section chapter-mist" aria-labelledby="wofaq-title">
    <div class="wrap wo-faq__grid">
      <div class="wo-faq__aside">
        <h2 id="wofaq-title" class="t-h2">{c.faqTitle}</h2>
        <p class="t-lead">{c.faqLead}</p>
        <a class="btn btn--wa" href={wa} rel="noopener" data-track="wa:catalog-faq">
          <Icon name="whatsapp" size={22} />{c.chat} {WA.wo.label}
        </a>
      </div>
      <Faq items={woFaqFor(lang)} id="faq-catalog" />
    </div>
  </section>
</Base>

<style>
  .cat-hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--s-8);
    align-items: end;
    padding-block: clamp(24px, 4vw, 56px) 0;
  }
  .cat-hero .t-lead {
    margin-top: var(--s-4);
  }
  .cat-hero__photo {
    aspect-ratio: 4 / 3;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-4) var(--s-6);
    padding-bottom: var(--s-5);
    border-bottom: 1px solid var(--line);
  }
  .filters__needs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
    max-width: 100%;
  }
  .fchip {
    position: relative;
  }
  .fchip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .fchip span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    padding: 0 var(--s-4);
    border-radius: 999px;
    background: var(--mist);
    color: var(--ink);
    font-size: var(--t-small);
    font-weight: 600;
    transition: background-color var(--t-hover) ease, color var(--t-hover) ease;
  }
  .fchip:hover span {
    background: var(--haze);
  }
  .fchip input:checked + span {
    background: var(--brand);
    color: #fff;
  }
  .fchip input:focus-visible + span {
    outline: 2.5px solid var(--focus);
    outline-offset: 2px;
  }
  .fchip--link {
    text-decoration: none;
  }
  .fchip--link span {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--brand);
  }
  .filters__selects {
    display: flex;
    gap: var(--s-4);
  }
  .filters__selects label {
    display: grid;
    gap: 2px;
    font-size: var(--t-micro);
    font-weight: 600;
    color: var(--ink-2);
  }
  .filters__selects select {
    min-height: 44px;
    padding: 0 var(--s-6) 0 var(--s-3);
    border: 1.5px solid var(--lilac);
    border-radius: var(--r-s);
    background: var(--paper);
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--ink);
  }
  .cat__count {
    margin-block: var(--s-5);
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .cat__grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
  }
  .cat__grid > li {
    display: grid;
  }
  .cat__empty {
    display: grid;
    gap: var(--s-3);
    justify-items: start;
    padding: var(--s-7);
    border-radius: var(--r-l);
    background: var(--mist);
  }
  .cat__empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-3);
  }


  .flow__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--s-8);
  }
  .flow__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7) var(--s-6);
  }
  .flow__num {
    display: block;
    font-family: var(--serif);
    font-size: 3rem;
    line-height: 1;
    color: var(--accent);
  }
  .flow__step h3 {
    margin-top: var(--s-4);
  }
  .flow__step p {
    margin-top: var(--s-2);
    color: var(--ink-2);
    max-width: 34ch;
  }

  .wo-faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--s-8);
  }
  .wo-faq__aside {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--s-4);
  }
  .wo-faq__aside .btn {
    white-space: normal;
    text-align: left;
    padding-block: var(--s-3);
  }

  @media (max-width: 1100px) {
    .cat__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .cat-hero,
    .flow__grid,
    .wo-faq__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }
    .cat-hero__photo {
      display: none;
    }
    .flow__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 640px) {
    .cat__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .filters__needs {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scrollbar-width: none;
      width: calc(100% + 2 * var(--gutter));
      max-width: none;
    }
    .fchip span {
      white-space: nowrap;
    }
    .filters__selects {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      width: 100%;
    }
    .filters__selects select {
      width: 100%;
    }
  }
</style>

<script>
  import "../scripts/catalog.ts";
</script>
