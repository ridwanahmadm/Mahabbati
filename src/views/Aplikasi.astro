---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Phone from "../components/Phone.astro";
import StoreBadges from "../components/StoreBadges.astro";
import Faq from "../components/Faq.astro";
import DownloadBlock from "../components/DownloadBlock.astro";
import { Image } from "astro:assets";
import { photo } from "../data/images";
import { appFaqFor, membershipFor, benefitsNoteFor } from "../data/content";
import { APLIKASI_COPY } from "../data/aplikasi";
import { PLAY_STORE_URL } from "../data/site";
import { langOf, path } from "../i18n/lang";
import { ui } from "../i18n/ui";

const lang = langOf(Astro.url);
const u = ui(lang);
const MEMBERSHIP = membershipFor(lang);
const BENEFITS_NOTE = benefitsNoteFor(lang);
const c = APLIKASI_COPY[lang];

const cell = (v: string | boolean | null) => v;
---

<Base
  title={c.title}
  description={c.desc}
  current="aplikasi"
  ogImage="n-khimar-bench"
>
  <section class="t-hero wrap" aria-labelledby="t-hero-title">
    <div class="t-hero__copy">
      <h1 id="t-hero-title" class="t-display">{c.h1}</h1>
      <p class="t-lead">{c.lead}</p>
      <StoreBadges from="taaruf-hero" class="t-hero__stores" />
      <p class="t-hero__note">{c.heroNote}</p>
    </div>
    <div class="t-hero__phones">
      <Phone src="kandidat" alt={c.phoneKandidat} width={270} class="t-hero__phone t-hero__phone--back" loading="eager" />
      <Phone src="home" alt={c.phoneHome} width={270} class="t-hero__phone t-hero__phone--front" loading="eager" />
    </div>
  </section>

  <section class="pains section" aria-labelledby="pains-title">
    <div class="wrap pains__grid">
      <h2 id="pains-title" class="t-h2 pains__title">{c.painsTitle}</h2>
      <ul class="pains__list">
        {
          c.pains.map((p) => (
            <li class="pain">
              <p class="pain__q">{p.pain}</p>
              <p class="pain__a">
                {p.answer}
                {p.link && (
                  <>
                    {" "}
                    <a class="link" href={p.link.href}>
                      {p.link.label}
                    </a>
                  </>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Satu hal yang hidup: the 7-day quota refund, played by the visitor -->
  <section id="anti-ghosting" class="ghost-sec section chapter-night on-dark" aria-labelledby="ghost-title">
    <div class="wrap ghost-sec__grid">
      <div class="ghost-sec__copy">
        <h2 id="ghost-title" class="t-h2">{c.ghostTitle}</h2>
        <p class="t-lead">{c.ghostLead}</p>
        <p class="ghost-sec__hint">{c.ghostHint}</p>
      </div>

      <div class="ghost" data-ghost data-i18n={JSON.stringify(c.ghostT)}>
        <div class="ghost__quota">
          <span>{c.quota}</span>
          <strong class="num" data-quota>10</strong>
          <svg class="ghost__coin" data-coin viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="20" cy="20" r="17" fill="#D9C38E" />
            <circle cx="20" cy="20" r="12.5" fill="none" stroke="#8A6E3B" stroke-width="2" />
            <path d="M20 13v14M13 20h14" stroke="#33324A" stroke-width="3" stroke-linecap="round" />
          </svg>
        </div>

        <article class="ghost__req" data-req data-state="idle">
          <div class="ghost__avatar" aria-hidden="true">AH</div>
          <div class="ghost__who">
            <p class="ghost__name">{c.who}</p>
            <p class="ghost__meta">{c.whoMeta}</p>
          </div>
          <p class="ghost__status" data-status>{c.idle}</p>
          <span class="ghost__stamp" aria-hidden="true">{c.stamp}</span>
        </article>

        <ol class="ghost__days" aria-hidden="true" data-days>
          {Array.from({ length: 7 }, (_, i) => <li>{i + 1}</li>)}
        </ol>

        <div class="ghost__controls">
          <button class="btn btn--lilac" type="button" data-send>{c.send}</button>
          <div class="ghost__time">
            <label for="ghost-day">{c.slide}</label>
            <input id="ghost-day" type="range" min="0" max="7" step="1" value="0" disabled data-range aria-valuetext={c.day0} />
            <output for="ghost-day" data-day>{c.day0}</output>
          </div>
          <div class="ghost__more">
            <button class="btn btn--outline" type="button" data-play disabled>
              <Icon name="play_arrow" size={20} />{c.play}
            </button>
            <button class="btn btn--outline" type="button" data-reset hidden>
              <Icon name="replay" size={20} />{c.again}
            </button>
          </div>
        </div>
        <p class="visually-hidden" role="status" data-live></p>
      </div>
    </div>
  </section>

  <section class="privacy section" aria-labelledby="privacy-title">
    <div class="wrap privacy__grid">
      <div class="privacy__copy">
        <h2 id="privacy-title" class="t-h2">{c.privTitle}</h2>
        <ul class="privacy__facts">
          {c.priv.map((x) => (
            <li>
              <Icon name={x.icon} size={26} />
              <div>
                <h3>{x.title}</h3>
                <p>{x.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="lock" data-photo-demo data-i18n={JSON.stringify(c.photoT)}>
        <figure class="lock__photo">
          <Image
            src={photo("n-khimar-purple")}
            alt={c.lockAlt}
            widths={[360, 540, 720]}
            sizes="(max-width: 900px) 80vw, 360px"
            class="lock__img"
            data-photo-img
          />
          <span class="lock__badge" data-photo-badge><Icon name="lock" size={18} />{c.locked}</span>
        </figure>
        <div class="lock__panel">
          <p class="lock__status" data-photo-status>{c.lockStatus}</p>
          <button class="btn" type="button" data-photo-request>{c.request}</button>
          <p class="lock__timer" data-photo-timer-wrap hidden>
            {c.timeLeft} <span class="num" data-photo-timer>24:00:00</span>
          </p>
        </div>
        <p class="visually-hidden" role="status" data-photo-live></p>
      </div>
    </div>
  </section>

  <section class="verify section chapter-mist" aria-labelledby="verify-title">
    <div class="wrap verify__grid">
      <div class="verify__phones">
        <Phone src="wna/id_capture" alt={c.verifyCapture} width={230} class="verify__phone" />
        <Phone src="wna/id_final" alt={c.verifyFinal} width={230} class="verify__phone verify__phone--b" />
      </div>
      <div class="verify__copy">
        <h2 id="verify-title" class="t-h2">{c.verifyTitle}</h2>
        <p class="t-lead">{c.verifyLead}</p>
        <ol class="verify__steps">
          {c.verifySteps.map((x) => <li><span>{x}</span></li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="ai section" aria-labelledby="ai-title">
    <div class="wrap ai__grid">
      <div class="ai__copy">
        <h2 id="ai-title" class="t-h2">{c.aiTitle}</h2>
        <p class="t-lead">{c.aiLead}</p>
        <p class="ai__note"><Icon name="verified" size={22} />{c.aiNote}</p>
      </div>
      <Phone src="ai" alt={c.aiPhone} width={300} class="ai__phone" />
    </div>
  </section>

  <section id="panduan" class="guide section chapter-mist" aria-labelledby="guide-title">
    <div class="wrap guide__grid">
      <div class="guide__aside">
        <h2 id="guide-title" class="t-h2">{c.guideTitle}</h2>
        <p class="t-lead">{c.guideLead}</p>
        <div class="guide__rules">
          <h3>{c.rulesTitle}</h3>
          <ul>
            {c.rules.map((x) => <li>{x}</li>)}
          </ul>
        </div>
      </div>
      <ol class="guide__steps">
        {
          c.steps.map((s, i) => (
            <li class="guide__step" data-reveal style={`--d:${(i % 2) * 70}`}>
              <span class="guide__num num" aria-hidden="true">
                {i + 1}
              </span>
              <div>
                <h3 class="t-h3">{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="pranikah" class="prep section" aria-labelledby="prep-title">
    <div class="wrap prep__head">
      <h2 id="prep-title" class="t-h2">{c.prepTitle}</h2>
      <p class="t-lead">{c.prepLead}</p>
      <div class="prep__nav">
        <button type="button" class="prep__btn" data-row-prev aria-controls="prep-row">
          <Icon name="chevron_left" size={26} /><span class="visually-hidden">{u.prev}</span>
        </button>
        <button type="button" class="prep__btn" data-row-next aria-controls="prep-row">
          <Icon name="chevron_right" size={26} /><span class="visually-hidden">{u.next}</span>
        </button>
      </div>
    </div>
    <div class="prep__row" id="prep-row" data-row data-cursor={u.drag} data-lenis-prevent tabindex="0" role="region" aria-label={c.prepRow}>
      <ul>
        {
          c.prep.map((p) => (
            <li class="prep__card">
              <Phone src={p.src} alt="" width={250} />
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="after section chapter-night on-dark" aria-labelledby="after-title">
    <div class="wrap after__grid">
      <div class="after__copy">
        <h2 id="after-title" class="t-h2">{c.afterTitle}</h2>
        <p class="t-lead">{c.afterLead}</p>
        {BENEFITS_NOTE && <p class="after__note">{BENEFITS_NOTE}</p>}
        <a class="btn btn--lilac" href={path(lang, "kelas")}>{c.seeClass}</a>
      </div>
      <ul class="after__list">
        {c.after.map((x) => <li><Icon name={x.icon} size={28} /><div><h3>{x.title}</h3><p>{x.body}</p></div></li>)}
      </ul>
    </div>
  </section>

  <section class="to-wo section" aria-labelledby="towo-title">
    <div class="wrap to-wo__inner">
      <h2 id="towo-title" class="t-h2">{c.woTitle}</h2>
      <p class="t-lead">{c.woLead}</p>
      <a class="btn" href={path(lang, "layanan")}>{c.woCta}</a>
    </div>
  </section>

  <section id="membership" class="members section chapter-mist" aria-labelledby="members-title">
    <div class="wrap">
      <div class="members__head">
        <h2 id="members-title" class="t-h2">{c.memTitle}</h2>
        <p class="t-lead">{c.memLead}</p>
      </div>
      <div class="members__scroll" data-lenis-prevent tabindex="0" role="region" aria-label={c.memRegion}>
        <table class="members__table">
          <caption class="visually-hidden">{c.memCaption}</caption>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">{c.feature}</span></th>
              {
                MEMBERSHIP.tiers.map((t) => (
                  <th scope="col" class:list={["members__tier", `members__tier--${t.toLowerCase()}`]}>
                    {t}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              MEMBERSHIP.rows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  {r.values.map((v) => (
                    <td>
                      {v === true && <Icon name="check" size={22} label={c.yes} />}
                      {(v === false || v === null) && (
                        <span class="members__no">
                          <span aria-hidden="true">–</span>
                          <span class="visually-hidden">{c.no}</span>
                        </span>
                      )}
                      {typeof v === "string" && <span class="num">{cell(v)}</span>}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <a class="btn members__cta" href={PLAY_STORE_URL} rel="noopener" data-track="play:membership">{c.memCta}</a>
    </div>
  </section>

  <section id="faq" class="faq-sec section" aria-labelledby="faq-title">
    <div class="wrap faq-sec__grid">
      <h2 id="faq-title" class="t-h2">{c.faqTitle}</h2>
      <Faq items={appFaqFor(lang)} id="faq-taaruf" />
    </div>
  </section>

  <DownloadBlock from="taaruf" />
</Base>

<style>
  /* ---------- Hero ---------- */
  .t-hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-7);
    align-items: center;
    padding-block: clamp(32px, 5vw, 72px) var(--s-8);
  }
  .t-hero__copy .t-lead {
    margin-top: var(--s-5);
  }
  .t-hero__copy :global(.t-hero__stores) {
    margin-top: var(--s-6);
  }
  .t-hero__note {
    margin-top: var(--s-4);
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .t-hero__phones {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: var(--s-5);
  }
  .t-hero__phones :global(.t-hero__phone--back) {
    order: 2;
    margin-top: var(--s-8);
  }
  @media (prefers-reduced-motion: no-preference) {
    .js .t-hero__phones :global(.t-hero__phone--front) {
      animation: phone-in 1100ms var(--ease-expo) 150ms both;
    }
    .js .t-hero__phones :global(.t-hero__phone--back) {
      animation: phone-in 1100ms var(--ease-expo) 300ms both;
    }
  }
  @keyframes phone-in {
    from {
      opacity: 0;
      transform: translateY(48px) rotate(2deg);
    }
  }

  /* ---------- Pains ---------- */
  .pains__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-8);
  }
  .pains__title {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    align-self: start;
  }
  .pains__list {
    list-style: none;
  }
  .pain {
    padding-block: var(--s-6);
    border-top: 1px solid var(--line);
  }
  .pain:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .pain__q {
    font-family: var(--serif);
    font-size: var(--t-h3);
    line-height: 1.3;
    color: var(--ink-2);
  }
  .pain__a {
    margin-top: var(--s-3);
    font-size: var(--t-lead);
    color: var(--ink);
    max-width: 44ch;
  }

  /* ---------- Anti-ghosting demo ---------- */
  .ghost-sec__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s-8);
    align-items: center;
  }
  .ghost-sec__copy .t-lead {
    margin-top: var(--s-5);
  }
  .ghost-sec__hint {
    margin-top: var(--s-5);
    font-family: var(--serif);
    font-style: italic;
    color: #fff;
  }
  .ghost {
    position: relative;
    padding: clamp(20px, 3vw, 36px);
    border-radius: 28px;
    background: var(--ground);
    color: var(--ink);
    --focus: var(--accent-ink);
  }
  .ghost__quota {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: var(--s-4) var(--s-5);
    border-radius: var(--r-m);
    background: var(--brand);
    color: var(--haze);
  }
  .ghost__quota strong {
    font-family: var(--serif);
    font-size: 2.5rem;
    font-weight: 400;
    color: #fff;
    line-height: 1;
  }
  .ghost__coin {
    position: absolute;
    right: 64px;
    top: 50%;
    width: 36px;
    height: 36px;
    opacity: 0;
    pointer-events: none;
  }
  .ghost__req {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-2) var(--s-4);
    align-items: center;
    margin-top: var(--s-5);
    padding: var(--s-5);
    border-radius: var(--r-m);
    background: var(--paper);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: clip;
  }
  .ghost__avatar {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--lilac);
    color: var(--night);
    font-weight: 700;
  }
  .ghost__name {
    font-weight: 600;
  }
  .ghost__meta {
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .ghost__status {
    grid-column: 1 / -1;
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--accent-ink);
  }
  .ghost__req[data-state="cancelled"] .ghost__status {
    color: var(--ink);
  }
  .ghost__stamp {
    position: absolute;
    right: 18px;
    top: 18px;
    padding: 6px 12px;
    border: 2px solid var(--brand);
    border-radius: var(--r-s);
    color: var(--brand);
    font-weight: 700;
    font-size: var(--t-small);
    rotate: -8deg;
    opacity: 0;
    scale: 1.6;
  }
  .ghost__req[data-state="cancelled"] .ghost__stamp {
    opacity: 1;
    scale: 1;
    transition: opacity 200ms ease, scale 380ms var(--ease-out);
  }
  .ghost__days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 6px;
    margin-top: var(--s-4);
    list-style: none;
  }
  .ghost__days li {
    display: grid;
    place-items: center;
    height: 36px;
    border-radius: var(--r-s);
    background: var(--mist);
    color: var(--ink-3);
    font-size: var(--t-micro);
    font-variant-numeric: tabular-nums;
    transition: background-color 200ms ease, color 200ms ease;
  }
  .ghost__days li:global(.is-past) {
    background: var(--lilac);
    color: var(--night);
  }
  .ghost__controls {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-5);
  }
  .ghost__time {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--s-3);
    align-items: center;
    font-size: var(--t-small);
  }
  .ghost__time input {
    accent-color: var(--brand);
    width: 100%;
    min-height: 32px;
  }
  .ghost__time input:disabled {
    opacity: 0.45;
  }
  .ghost__time output {
    min-width: 5.5em;
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }
  .ghost__more {
    display: flex;
    gap: var(--s-3);
  }
  .ghost .btn--outline {
    --btn-fg: var(--brand);
    --btn-bg-hover: var(--haze);
    box-shadow: inset 0 0 0 1.5px var(--brand);
  }
  .ghost .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .ghost .btn--lilac {
    --btn-bg: var(--brand);
    --btn-fg: #fff;
    --btn-bg-hover: var(--night);
  }

  /* ---------- Privacy demo ---------- */
  .privacy__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--s-8);
    align-items: center;
  }
  .privacy__facts {
    list-style: none;
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-6);
  }
  .privacy__facts li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-4);
  }
  .privacy__facts li > :global(.icon) {
    color: var(--accent);
    margin-top: 2px;
  }
  .privacy__facts h3 {
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .privacy__facts p {
    color: var(--ink-2);
    max-width: 44ch;
  }
  .lock {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
    max-width: 380px;
    margin-inline: auto;
  }
  .lock__photo {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-l);
    overflow: clip;
    background: var(--haze);
  }
  .lock__photo :global(.lock__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(22px) saturate(0.7);
    transform: scale(1.12);
    transition: filter 900ms var(--ease-out), transform 900ms var(--ease-out);
  }
  .lock:global(.is-open) .lock__photo :global(.lock__img) {
    filter: none;
    transform: none;
  }
  .lock__badge {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: var(--r-s);
    background: var(--ground);
    color: var(--ink);
    font-size: var(--t-small);
    font-weight: 600;
  }
  .lock__status {
    font-size: var(--t-small);
    color: var(--ink-2);
    min-height: 3em;
  }
  .lock__timer {
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .lock__timer .num {
    font-weight: 700;
    color: var(--ink);
  }

  /* ---------- Verify ---------- */
  .verify__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s-8);
    align-items: center;
  }
  .verify__phones {
    display: flex;
    align-items: flex-start;
    gap: var(--s-5);
    justify-content: center;
  }
  .verify__phones :global(.verify__phone--b) {
    margin-top: var(--s-8);
  }
  .verify__copy .t-lead {
    margin-top: var(--s-5);
  }
  .verify__steps {
    display: grid;
    gap: var(--s-3);
    margin-top: var(--s-6);
    padding-left: 1.4em;
    font-weight: 500;
  }
  .verify__steps li::marker {
    font-family: var(--serif);
    color: var(--accent-ink);
  }

  /* ---------- AI ---------- */
  .ai__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--s-8);
