    padding-left: 1.4em;
    font-weight: 500;
  }
  .verify__steps li::marker {
    font-family: var(--serif);
    color: var(--accent-ink);
  }

  /* ---------- AI ---------- */
  .ai__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--s-8);
    align-items: center;
  }
  .ai__copy .t-lead {
    margin-top: var(--s-5);
  }
  .ai__note {
    margin-top: var(--s-5);
    display: flex;
    align-items: center;
    gap: var(--s-2);
