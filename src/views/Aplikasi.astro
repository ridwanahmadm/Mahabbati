    top: calc(var(--header-h) + 32px);
    align-self: start;
  }
  .guide__aside .t-lead {
    margin-top: var(--s-4);
  }
  .guide__rules {
    margin-top: var(--s-6);
    padding: var(--s-5);
    border-radius: var(--r-m);
