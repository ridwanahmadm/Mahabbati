  }
  .ai__note :global(.icon) {
    color: var(--accent);
  }
  .ai__grid :global(.ai__phone) {
    justify-self: center;
  }

  /* ---------- Guide ---------- */
  .guide__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s-8);
  }
