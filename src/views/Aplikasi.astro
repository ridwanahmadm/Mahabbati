  }
  .guide__step:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .guide__num {
    font-family: var(--serif);
    font-size: 2rem;
    line-height: 1.1;
    color: var(--accent);
  }
  .guide__step p {
    margin-top: var(--s-2);
    color: var(--ink-2);
    max-width: 48ch;
  }

  /* ---------- Pranikah drag row ---------- */
  .prep__head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr) auto;
    gap: var(--s-5) var(--s-7);
    align-items: end;
  }
  .prep__nav {
    display: flex;
    gap: var(--s-2);
  }
  .prep__btn {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 0;
    border-radius: 50%;
    background: var(--haze);
    color: var(--brand);
    transition: background-color var(--t-hover) ease, opacity var(--t-hover) ease;
  }
  .prep__btn:hover {
    background: var(--lilac);
  }
  .prep__btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .prep__row {
    margin-top: var(--s-7);
