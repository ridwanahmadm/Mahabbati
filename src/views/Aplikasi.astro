    font-size: 1.25rem;
  }
  .prep__card p {
    margin-top: var(--s-2);
    color: var(--ink-2);
    font-size: var(--t-small);
  }

  /* ---------- After marriage ---------- */
  .after__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s-8);
    align-items: center;
  }
  .after__copy {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
  }
  .after__note {
    font-size: var(--t-small);
    color: var(--lilac);
