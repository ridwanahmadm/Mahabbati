    background: var(--ground);
    color: var(--ink);
    font-size: var(--t-small);
    font-weight: 600;
  }
  .lock__status {
    font-size: var(--t-small);
    color: var(--ink-2);
    min-height: 3em;
  }
  .lock__timer {
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .lock__timer .num {
    font-weight: 700;
    color: var(--ink);
  }

  /* ---------- Verify ---------- */
  .verify__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s-8);
    align-items: center;
  }
  .verify__phones {
    display: flex;
    align-items: flex-start;
    gap: var(--s-5);
    justify-content: center;
  }
  .verify__phones :global(.verify__phone--b) {
    margin-top: var(--s-8);
  }
  .verify__copy .t-lead {
    margin-top: var(--s-5);
  }
  .verify__steps {
    display: grid;
    gap: var(--s-3);
