---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { Image } from "astro:assets";
import { photo } from "../data/images";
import KelasBand from "../components/KelasBand.astro";
import VenueCard from "../components/VenueCard.astro";
import PackageCard from "../components/PackageCard.astro";
import { packagesFor, ADDONS, addonLabel, rundownFor, estimate, itemsFor, needLabel, findPackage, type AddonId } from "../data/packages";
import { venuesFor } from "../data/venues";
import { WA, waLink, rupiah as rp, rupiahShort as rps } from "../data/site";
import { langOf, path } from "../i18n/lang";
import { ui, numLocale } from "../i18n/ui";

interface Props {
  slug: string;
}
const lang = langOf(Astro.url);
const u = ui(lang);
const rupiah = (n: number) => rp(n, lang);
const rupiahShort = (n: number) => rps(n, lang);
const PACKAGES = packagesFor(lang);
const VENUES = venuesFor(lang);
const pkg = findPackage(Astro.props.slug, lang)!;
const COPY = {
  id: {
    desc: (from: string) => `${pkg.promise} ${pkg.forWho} Mulai ${from}.`,
    crumbs: "Layanan",
    sampleNote: "Harga dan rincian paket ini masih contoh dan akan diperbarui.",
    estimateCta: "Hitung estimasi",
    ask: "Tanya tim WO",
    galleryAlt: `Suasana ${pkg.name}`,
    isi: "Isi paket.",
    variantHead: (name: string, price: string, n: number) => `Varian ${name}, ${price}, sudah termasuk ${n} tamu`,
    rundown: "Contoh susunan hari H.",
    rundownLead: "Gambaran alur akad dan walimah di pagi hari. Rundown aslinya kami susun bersama keluargamu.",
    gallery: "Galeri suasana.",
    galleryLead: "Foto ilustrasi. Portofolio acara kami bisa kamu lihat saat konsultasi.",
    galleryRow: "Galeri foto, geser ke samping",
    estTitle: "Hitung estimasi",
    variant: "Varian",
    guests: "Perkiraan jumlah tamu",
    guestsRange: "Geser jumlah tamu",
    included: "Sudah termasuk {n} tamu.",
    addons: "Tambahan",
    estLabel: "Estimasi awal",
    consultPkg: "Konsultasikan paket ini",
    estNote: "Estimasi awal sebagai gambaran. Harga final mengikuti lokasi, menu, dan jumlah tamu, dan tertulis di penawaran resmi.",
    kTitle: "Termasuk kelas pranikah dari asatidz Mahabbati.",
    kLead: "Setelah paket dipesan, kalian mendapat akses kelas pranikah dan nasihat pernikahan di aplikasi Mahabbati.",
    kCta: "Lihat isi kelasnya",
    venues: "Tempat mitra yang cocok.",
    allVenues: "Semua tempat mitra",
    others: "Paket lainnya.",
    sticky: "Estimasi",
    consult: "Konsultasi",
    t: {
      included: "Sudah termasuk {n} tamu.",
      over: "Tambahan {over} tamu dihitung per {per} tamu.",
      extraRow: "Tambahan {over} tamu",
      greet: "Assalamu'alaikum, Tim WO Mahabbati. Saya tertarik dengan paket {name}.",
      guests: "Perkiraan tamu: {n} orang",
      addons: "Tambahan: {list}",
      estimate: "Estimasi dari website: {total}",
      close: "Boleh dibantu jadwal konsultasinya?",
    },
  },
  en: {
    desc: (from: string) => `${pkg.promise} ${pkg.forWho} From ${from}.`,
    crumbs: "Services",
    sampleNote: "This package's prices and details are a sample and will be updated.",
    estimateCta: "Estimate the cost",
    ask: "Ask the WO team",
    galleryAlt: `The feel of ${pkg.name}`,
    isi: "What's included.",
    variantHead: (name: string, price: string, n: number) => `${name}, ${price}, includes ${n} guests`,
    rundown: "A sample wedding-day rundown.",
    rundownLead: "A morning akad and walimah, for a sense of the flow. Your real rundown is planned with your family.",
    gallery: "Gallery.",
    galleryLead: "Illustrative photos. You can see our event portfolio when we meet.",
    galleryRow: "Photo gallery, scroll sideways",
    estTitle: "Estimate the cost",
    variant: "Option",
    guests: "Expected number of guests",
    guestsRange: "Slide to set guests",
    included: "Includes {n} guests.",
    addons: "Add-ons",
    estLabel: "First estimate",
    consultPkg: "Ask about this package",
    estNote: "A first estimate, for planning. The final price depends on location, menu and guests, and is set out in a written quote.",
    kTitle: "Includes the pre-marriage class from the asatidz of Mahabbati.",
    kLead: "Once you book, you both get access to the pre-marriage class and marriage advice in the Mahabbati app.",
    kCta: "See what's in the class",
    venues: "Partner venues that fit.",
    allVenues: "All partner venues",
    others: "Other packages.",
    sticky: "Estimate",
    consult: "Talk to us",
    t: {
      included: "Includes {n} guests.",
      over: "{over} extra guests are charged per {per}.",
      extraRow: "{over} extra guests",
      greet: "Assalamu'alaikum, Mahabbati WO team. I'm interested in the {name} package.",
      guests: "Expected guests: {n}",
      addons: "Add-ons: {list}",
      estimate: "Website estimate: {total}",
      close: "Could you help me book a consultation?",
    },
  },
};
const c = COPY[lang];
const fill = (tpl: string, v: Record<string, string | number>) => tpl.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ""));
const v0 = pkg.variants[0];
const multi = pkg.variants.length > 1;
const addonIds = [...new Set(pkg.variants.flatMap((v) => v.addons))] as AddonId[];
const others = [
  ...PACKAGES.filter((p) => p.slug !== pkg.slug && p.need === pkg.need),
  ...PACKAGES.filter((p) => p.slug !== pkg.slug && p.need !== pkg.need && p.featured),
].slice(0, 3);
const venues = VENUES.filter((v) => v.needs.includes(pkg.need)).slice(0, 3);
const firstTotal = estimate(v0, v0.guests.included);
const waText = (variantName: string, guests: number, total: number) =>
  [fill(c.t.greet, { name: multi ? `${pkg.name} (${variantName})` : pkg.name }), fill(c.t.guests, { n: guests }), fill(c.t.estimate, { total: rupiah(total) }), c.t.close].join("\n");
const waHref = waLink(WA.wo.number, waText(v0.name, v0.guests.included, firstTotal));

const data = {
  name: pkg.name,
  multi,
  waNumber: WA.wo.number,
  variants: pkg.variants.map((v) => ({
    id: v.id,
    name: v.name,
    price: v.price,
    guests: v.guests,
    extra: v.extra,
    addons: v.addons,
  })),
  addons: Object.fromEntries(addonIds.map((id) => [id, { label: addonLabel(id, lang), price: ADDONS[id].price }])),
  locale: numLocale(lang),
  t: c.t,
};

const offer = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: `${pkg.name}, Wedding Organizer Mahabbati`,
  description: pkg.summary,
  brand: { "@type": "Brand", name: "Mahabbati" },
  offers: pkg.variants.map((v) => ({ "@type": "Offer", name: v.name, priceCurrency: "IDR", price: v.price })),
};
---

<Base
  title={`${pkg.name} | Wedding Organizer Mahabbati`}
  description={c.desc(rupiahShort(pkg.priceFrom))}
  current="layanan"
  slug={pkg.slug}
  ogImage={pkg.photo}
  jsonLd={[offer]}
>
  <nav class="crumbs wrap" aria-label="Breadcrumb">
    <ol>
      <li><a href={path(lang, "layanan")}>{c.crumbs}</a></li>
      <li><a href={`${path(lang, "layanan")}?kebutuhan=${pkg.need}`}>{needLabel(pkg.need, lang)}</a></li>
      <li aria-current="page">{pkg.name}</li>
    </ol>
  </nav>

  <section class="pd-hero wrap" aria-labelledby="pd-title">
    <div class="pd-hero__copy">
      <h1 id="pd-title" class="t-display">{pkg.name}</h1>
      <p class="pd-hero__promise">{pkg.promise}</p>
      {
        pkg.placeholder && (
          <p class="sample-note pd-hero__note">
            <Icon name="info" size={20} />
            {c.sampleNote}
          </p>
        )
      }
      <p class="t-lead">{pkg.summary}</p>
      <p class="pd-hero__price">
        <span>{u.from}</span>
        <strong class="num">{rupiah(pkg.priceFrom)}</strong>
      </p>
      <div class="pd-hero__ctas">
        <a class="btn" href="#estimasi">{c.estimateCta}</a>
        <a class="btn btn--outline" href={waHref} rel="noopener" data-track={`wa:${pkg.slug}-hero`}>
          <Icon name="whatsapp" size={20} />{c.ask}
        </a>
      </div>
    </div>
    <div class="pd-gallery">
      <figure class="pd-gallery__main" data-shutter>
        <Image
          src={photo(pkg.gallery[0])}
          alt={c.galleryAlt}
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 900px) 92vw, 34vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
      {
        pkg.gallery.slice(1, 3).map((g, i) => (
          <figure class:list={["pd-gallery__side photo", `pd-gallery__side--${i}`]} data-reveal="mask">
            <Image src={photo(g)} alt="" widths={[320, 480, 640]} sizes="(max-width: 900px) 44vw, 16vw" loading="eager" />
          </figure>
        ))
      }
    </div>
  </section>

  <div class="pd-body wrap">
    <div class="pd-main">
      <section class="pd-sec" aria-labelledby="isi-title">
        <h2 id="isi-title" class="t-h2">{c.isi}</h2>
        {
          pkg.variants.map((v, i) => (
            <div class="pd-items" data-variant-panel={v.id} hidden={i > 0 ? true : undefined}>
              {multi && <h3 class="pd-items__variant">{c.variantHead(v.name, rupiah(v.price), v.guests.included)}</h3>}
              <ul>
                {itemsFor(pkg, v, lang).map((it) => (
                  <li class="pd-item">
                    <Icon name={it.icon} size={28} class="pd-item__icon" />
                    <div>
                      <p class="pd-item__label">{it.label}</p>
                      <p class="pd-item__value">{it.value}</p>
                      <p class="pd-item__detail">{it.detail}</p>
                    </div>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section class="pd-sec" aria-labelledby="rundown-title">
        <h2 id="rundown-title" class="t-h2">{c.rundown}</h2>
        <p class="pd-sec__lead">{c.rundownLead}</p>
        <ol class="rundown">
          {
            rundownFor(lang).map((r) => (
              <li class="rundown__row" data-reveal>
                <time class="rundown__time num">{r.time}</time>
                <div>
                  <h3>{r.title}</h3>
                  <p>{r.note}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="pd-sec" aria-labelledby="gal-title">
        <div class="pd-gal__head">
          <h2 id="gal-title" class="t-h2">{c.gallery}</h2>
          <div class="pd-gal__nav">
            <button type="button" class="round-btn" data-row-prev aria-controls="pd-row">
              <Icon name="chevron_left" size={26} /><span class="visually-hidden">{u.prev}</span>
            </button>
            <button type="button" class="round-btn" data-row-next aria-controls="pd-row">
              <Icon name="chevron_right" size={26} /><span class="visually-hidden">{u.next}</span>
            </button>
          </div>
        </div>
        <p class="pd-sec__lead">{c.galleryLead}</p>
        <div class="pd-row" id="pd-row" data-row data-cursor={u.drag} data-lenis-prevent tabindex="0" role="region" aria-label={c.galleryRow}>
          <ul>
            {
              pkg.gallery.map((g) => (
                <li class="pd-row__item photo">
                  <Image src={photo(g)} alt="" widths={[360, 540, 720]} sizes="320px" />
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    </div>

    <aside id="estimasi" class="est" aria-labelledby="est-title" data-estimator>
      <h2 id="est-title" class="est__title">{c.estTitle}</h2>
      <form class="est__form" onsubmit="return false">
        {
          multi && (
            <fieldset class="est__field">
              <legend>{c.variant}</legend>
              <div class="seg">
                {pkg.variants.map((v, i) => (
                  <label class="seg__opt">
                    <input type="radio" name="variant" value={v.id} checked={i === 0} data-variant />
                    <span>
                      {v.name}
                      <small class="num">{rupiahShort(v.price)}</small>
                    </span>
                  </label>
                ))}
              </div>
            </fieldset>
          )
        }

        <div class="est__field">
          <label for="est-guests">{c.guests}</label>
          <div class="est__guests">
            <input
              id="est-guests-range"
              type="range"
              min={v0.guests.min}
              max={v0.guests.max}
              step={v0.guests.step}
              value={v0.guests.included}
              aria-label={c.guestsRange}
              data-guests-range
            />
            <input
              id="est-guests"
              type="number"
              inputmode="numeric"
              min={v0.guests.min}
              max={v0.guests.max}
              step={v0.guests.step}
              value={v0.guests.included}
              aria-describedby="est-guests-hint"
              data-guests
            />
          </div>
          <p id="est-guests-hint" class="est__hint" data-guests-hint>
            {fill(c.included, { n: v0.guests.included })}
          </p>
        </div>

        <fieldset class="est__field">
          <legend>{c.addons}</legend>
          <ul class="est__addons">
            {
              addonIds.map((id) => (
                <li data-addon-row={id} data-for={pkg.variants.filter((v) => v.addons.includes(id)).map((v) => v.id).join(" ")}>
                  <label>
                    <input type="checkbox" value={id} data-addon />
                    <span>{addonLabel(id, lang)}</span>
                    <span class="num est__addon-price">+{rupiahShort(ADDONS[id].price)}</span>
                  </label>
                </li>
              ))
            }
          </ul>
        </fieldset>
      </form>

      <div class="est__result">
        <p class="est__label">{c.estLabel}</p>
        <p class="est__total num" data-total aria-live="polite">{rupiah(firstTotal)}</p>
        <ul class="est__breakdown" data-breakdown>
          <li><span>{multi ? `${pkg.name}, ${v0.name}` : pkg.name}</span><span class="num">{rupiah(v0.price)}</span></li>
        </ul>
      </div>
      <a class="btn btn--wa est__cta" href={waHref} rel="noopener" data-wa data-track={`wa:${pkg.slug}-estimator`}>
        <Icon name="whatsapp" size={22} />{c.consultPkg}
      </a>
      <p class="est__note">
        {c.estNote}
      </p>
    </aside>
  </div>

  {
    pkg.includesClass && (
      <KelasBand
        id="pdk-title"
        title={c.kTitle}
        lead={c.kLead}
        cta={c.kCta}
      />
    )
  }

  {
    venues.length > 0 && (
      <section class="pd-venues section" aria-labelledby="pdv-title">
        <div class="wrap">
          <div class="pd-venues__head">
            <h2 id="pdv-title" class="t-h2">{c.venues}</h2>
            <a class="link" href={path(lang, "tempat")}>{c.allVenues}</a>
          </div>
          <ul class="card-grid">
            {venues.map((v) => (
              <li>
                <VenueCard venue={v} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="others section chapter-mist" aria-labelledby="others-title">
    <div class="wrap">
      <h2 id="others-title" class="t-h2">{c.others}</h2>
      <ul class="card-grid">
        {
          others.map((o) => (
            <li>
              <PackageCard pkg={o} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="sticky-est" data-sticky-est hidden>
    <div>
      <span>{c.sticky}</span>
      <strong class="num" data-sticky-total>{rupiah(firstTotal)}</strong>
    </div>
    <a class="btn btn--wa" href={waHref} rel="noopener" data-wa data-track={`wa:${pkg.slug}-sticky`}>{c.consult}</a>
  </div>

  <script type="application/json" id="est-data" set:html={JSON.stringify(data)} />
</Base>

<style>
  .crumbs {
    padding-top: var(--s-5);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    list-style: none;
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .crumbs li + li::before {
    content: "/";
    margin-right: var(--s-2);
    color: var(--ink-3);
  }
  .crumbs a {
    color: var(--accent-ink);
    text-underline-offset: 0.2em;
  }

  .pd-hero {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: var(--s-8);
    align-items: center;
    padding-block: var(--s-6) var(--s-9);
  }
  .pd-hero__promise {
    margin-top: var(--s-4);
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--t-h3);
    color: var(--accent-ink);
  }
  .pd-hero__copy .t-lead {
    margin-top: var(--s-4);
  }
  .pd-hero__price {
    display: grid;
    margin-top: var(--s-6);
  }
  .pd-hero__price span {
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .pd-hero__price strong {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.75rem);
  }
  .pd-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .pd-gallery {
    display: grid;
    grid-template-columns: 3fr 2fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--s-4);
    height: clamp(420px, 44vw, 620px);
  }
  .pd-gallery__main {
    grid-row: span 2;
    border-radius: var(--r-l);
    overflow: clip;
    background: var(--haze);
  }
  .pd-gallery__main :global(img),
  .pd-gallery__side :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    .js .pd-gallery__main {
      animation: shutter 1200ms var(--ease-in-out) 100ms both;
    }
    .js .pd-gallery__main :global(img) {
      animation: settle 1400ms var(--ease-expo) 100ms both;
    }
  }
  @keyframes shutter {
    from {
      clip-path: inset(100% 0 0 0 round var(--r-l));
    }
    to {
      clip-path: inset(0 0 0 0 round var(--r-l));
    }
  }
  @keyframes settle {
    from {
      transform: scale(1.12);
    }
  }

  .pd-body {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--s-8);
    align-items: start;
    padding-bottom: var(--section);
  }
  .pd-sec + .pd-sec {
    margin-top: var(--s-9);
  }
  .pd-sec__lead {
    margin-top: var(--s-3);
    color: var(--ink-2);
  }
  .pd-items {
    margin-top: var(--s-6);
  }
  .pd-items__variant {
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--ink-2);
    margin-bottom: var(--s-4);
  }
  .pd-items ul {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--s-6);
  }
  .pd-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-4);
    padding-block: var(--s-5);
    border-top: 1px solid var(--line);
  }
  .pd-item :global(.pd-item__icon) {
    color: var(--accent);
    margin-top: 2px;
  }
  .pd-item__label {
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .pd-item__value {
    font-family: var(--serif);
    font-size: 1.3125rem;
    line-height: 1.3;
  }
  .pd-item__detail {
    margin-top: var(--s-2);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .rundown {
    list-style: none;
    margin-top: var(--s-6);
    border-left: 2px solid var(--haze);
    margin-left: 8px;
  }
  .rundown__row {
    position: relative;
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: var(--s-4);
    padding: 0 0 var(--s-6) var(--s-5);
  }
  .rundown__row::before {
    content: "";
    position: absolute;
    left: -7px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--ground);
    box-shadow: inset 0 0 0 2px var(--accent);
  }
  .rundown__time {
    font-weight: 600;
    color: var(--accent-ink);
  }
  .rundown__row h3 {
    font-size: 1.0625rem;
    font-weight: 600;
  }
  .rundown__row p {
    color: var(--ink-2);
    font-size: var(--t-small);
  }

  .pd-gal__head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: var(--s-5);
  }
  .pd-gal__nav {
    display: flex;
    gap: var(--s-2);
  }
  .round-btn {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border: 0;
    border-radius: 50%;
    background: var(--haze);
    color: var(--brand);
    transition: background-color var(--t-hover) ease, opacity var(--t-hover) ease;
  }
  .round-btn:hover {
    background: var(--lilac);
  }
  .round-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }
  .pd-row {
    margin-top: var(--s-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    cursor: grab;
    border-radius: var(--r-l);
  }
  .pd-row::-webkit-scrollbar {
    display: none;
  }
  .pd-row:global(.is-dragging) {
    cursor: grabbing;
    scroll-snap-type: none;
  }
  .pd-row ul {
    display: flex;
    gap: var(--s-4);
    list-style: none;
    width: max-content;
  }
