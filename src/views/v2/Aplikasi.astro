---
// The ta’aruf app page in the WO-first variant. Same copy, demos and screens as /aplikasi/ (src/data/aplikasi.ts),
// set in the v2 world: ivory paper, violet ink, gold hairlines, deep-violet bands for the two "living" sections.
import QRCode from "qrcode";
import V2Layout from "../../layouts/V2.astro";
import Icon from "../../components/Icon.astro";
import Logo from "../../components/Logo.astro";
import AppScreen from "../../components/v2/AppScreen.astro";
import { Image } from "astro:assets";
import { photo } from "../../data/images";
import { appFaqFor, membershipFor, benefitsNoteFor } from "../../data/content";
import { APLIKASI_COPY } from "../../data/aplikasi";
import { PLAY_STORE_URL, url } from "../../data/site";
import { V2 } from "../../data/v2";

const c = APLIKASI_COPY.id;
const MEMBERSHIP = membershipFor("id");
const BENEFITS_NOTE = benefitsNoteFor("id");
const FAQ = appFaqFor("id");
const dl = {
  title: "Ajukan ta'aruf pertamamu gratis.",
  body: "Pencarian calon, pengajuan ta'aruf, dan chat hanya ada di aplikasi Mahabbati. Daftar gratis, lalu lengkapi biodata pelan-pelan.",
  qr: "Arahkan kamera ponselmu ke kode ini untuk langsung ke Google Play.",
};
const qr = await QRCode.toString(PLAY_STORE_URL, { type: "svg", margin: 0, errorCorrectionLevel: "M" });
---

<V2Layout title={c.title} description={c.desc} current="aplikasi">
  <nav class="crumbs container" aria-label="Breadcrumb">
    <ol>
      <li><a href={V2("/")}>Beranda</a></li>
      <li aria-current="page">Aplikasi Ta’aruf</li>
    </ol>
  </nav>

  <section class="container app-hero" aria-labelledby="app-hero-title">
    <div class="app-hero__copy">
      <h1 id="app-hero-title">{c.h1}</h1>
      <span class="hero__rule" aria-hidden="true"></span>
      <p class="hero__lead">{c.lead}</p>
      <div class="hero__actions">
        <a class="btn" href={PLAY_STORE_URL} rel="noopener" data-track="play:v2-taaruf-hero">
          <Icon name="google-play" size={18} />Unduh di Google Play
        </a>
        <a class="btn btn--quiet" href="#panduan">Lihat panduan ta’aruf</a>
      </div>
      <p class="app-hero__note">{c.heroNote}</p>
    </div>
    <div class="app-hero__phones">
      <AppScreen src="kandidat" alt={c.phoneKandidat} width={260} class="app-hero__phone app-hero__phone--back" loading="eager" />
      <AppScreen src="home" alt={c.phoneHome} width={260} class="app-hero__phone app-hero__phone--front" loading="eager" />
    </div>
  </section>

  <section class="sec band" aria-labelledby="pains-title">
    <div class="container split">
      <h2 id="pains-title">{c.painsTitle}</h2>
      <ul class="pains">
        {
          c.pains.map((p) => (
            <li>
              <h3>{p.pain}</h3>
              <p>
                {p.answer}
                {p.link && (
                  <>
                    {" "}
                    <a class="text-link" href={p.link.href}>{p.link.label}</a>
                  </>
                )}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="anti-ghosting" class="sec night" aria-labelledby="ghost-title">
    <div class="container split split--center">
      <div>
        <h2 id="ghost-title">{c.ghostTitle}</h2>
        <p class="sec-lead">{c.ghostLead}</p>
        <p class="night__hint">{c.ghostHint}</p>
      </div>

      <div class="ghost" data-ghost data-i18n={JSON.stringify(c.ghostT)}>
        <div class="ghost__quota">
          <span>{c.quota}</span>
          <strong data-quota>10</strong>
          <svg class="ghost__coin" data-coin viewBox="0 0 40 40" aria-hidden="true">
            <circle cx="20" cy="20" r="17" />
            <circle cx="20" cy="20" r="12.5" />
            <path d="M20 13v14M13 20h14" />
          </svg>
        </div>

        <article class="ghost__req" data-req data-state="idle">
          <div class="ghost__avatar" aria-hidden="true">AH</div>
          <div>
            <p class="ghost__name">{c.who}</p>
            <p class="ghost__meta">{c.whoMeta}</p>
          </div>
          <p class="ghost__status" data-status>{c.idle}</p>
          <span class="ghost__stamp" aria-hidden="true">{c.stamp}</span>
        </article>

        <ol class="ghost__days" aria-hidden="true" data-days>
          {Array.from({ length: 7 }, (_, i) => <li>{i + 1}</li>)}
        </ol>

        <div class="ghost__controls">
          <button class="btn" type="button" data-send>{c.send}</button>
          <div class="ghost__time">
            <label for="ghost-day">{c.slide}</label>
            <input id="ghost-day" type="range" min="0" max="7" step="1" value="0" disabled data-range aria-valuetext={c.day0} />
            <output for="ghost-day" data-day>{c.day0}</output>
          </div>
          <div class="ghost__more">
            <button class="btn btn--quiet" type="button" data-play disabled>
              <Icon name="play_arrow" size={20} />{c.play}
            </button>
            <button class="btn btn--quiet" type="button" data-reset hidden>
              <Icon name="replay" size={20} />{c.again}
            </button>
          </div>
        </div>
        <p class="visually-hidden" role="status" data-live></p>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="privacy-title">
    <div class="container split split--center">
      <div>
        <h2 id="privacy-title">{c.privTitle}</h2>
        <ul class="facts">
          {
            c.priv.map((x) => (
              <li>
                <Icon name={x.icon} size={24} />
                <div>
                  <h3>{x.title}</h3>
                  <p>{x.body}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lock" data-photo-demo data-i18n={JSON.stringify(c.photoT)}>
        <figure class="lock__photo">
          <Image
            src={photo("n-khimar-purple")}
            alt={c.lockAlt}
            widths={[360, 540, 720]}
            sizes="(max-width: 60rem) 80vw, 380px"
            class="lock__img"
            data-photo-img
          />
          <span class="lock__badge" data-photo-badge><Icon name="lock" size={18} />{c.locked}</span>
        </figure>
        <div class="lock__panel">
          <p class="lock__status" data-photo-status>{c.lockStatus}</p>
          <button class="btn" type="button" data-photo-request>{c.request}</button>
          <p class="lock__timer" data-photo-timer-wrap hidden>
            {c.timeLeft} <span data-photo-timer>24:00:00</span>
          </p>
        </div>
        <p class="visually-hidden" role="status" data-photo-live></p>
      </div>
    </div>
  </section>

  <section class="sec band" aria-labelledby="verify-title">
    <div class="container split split--center split--media-first">
      <div class="duo">
        <AppScreen src="wna/id_capture" alt={c.verifyCapture} width={220} />
        <AppScreen src="wna/id_final" alt={c.verifyFinal} width={220} class="duo__b" />
      </div>
      <div>
        <h2 id="verify-title">{c.verifyTitle}</h2>
        <p class="sec-lead">{c.verifyLead}</p>
        <ol class="ticks">
          {c.verifySteps.map((x) => <li>{x}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="sec" aria-labelledby="ai-title">
    <div class="container split split--center">
      <div>
        <h2 id="ai-title">{c.aiTitle}</h2>
        <p class="sec-lead">{c.aiLead}</p>
        <p class="ai-note"><Icon name="verified" size={22} />{c.aiNote}</p>
      </div>
      <AppScreen src="ai" alt={c.aiPhone} width={290} class="solo" />
    </div>
  </section>

  <section id="panduan" class="sec band" aria-labelledby="guide-title">
    <div class="container split">
      <div class="guide__aside">
        <h2 id="guide-title">{c.guideTitle}</h2>
        <p class="sec-lead">{c.guideLead}</p>
        <div class="guide__rules">
          <h3>{c.rulesTitle}</h3>
          <ul>
            {c.rules.map((x) => <li>{x}</li>)}
          </ul>
        </div>
      </div>
      <ol class="guide">
        {
          c.steps.map((s, i) => (
            <li class:list={{ "guide__last": i === c.steps.length - 1 }}>
              <span class="guide__num" aria-hidden="true">{i + 1}</span>
              <div>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                {i === c.steps.length - 1 && (
                  <a class="text-link" href={V2("/layanan/")}>Lihat paket WO</a>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="pranikah" class="sec" aria-labelledby="prep-title">
    <div class="container">
      <div class="pf-head">
        <div>
          <h2 id="prep-title">{c.prepTitle}</h2>
          <p class="pf-note">{c.prepLead}</p>
        </div>
        <div class="pf-nav">
          <button type="button" class="round-btn" data-rail-prev aria-controls="prep-rail">
            <Icon name="chevron_left" size={24} /><span class="visually-hidden">Sebelumnya</span>
          </button>
          <button type="button" class="round-btn" data-rail-next aria-controls="prep-rail">
            <Icon name="chevron_right" size={24} /><span class="visually-hidden">Berikutnya</span>
          </button>
        </div>
      </div>
      <div class="rail prep" id="prep-rail" data-rail tabindex="0" role="region" aria-label={c.prepRow}>
        <ul>
          {
            c.prep.map((p) => (
              <li>
                <AppScreen src={p.src} alt="" width={230} />
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="sec night" aria-labelledby="after-title">
    <div class="container split split--center">
      <div>
        <h2 id="after-title">{c.afterTitle}</h2>
        <p class="sec-lead">{c.afterLead}</p>
        {BENEFITS_NOTE && <p class="night__hint">{BENEFITS_NOTE}</p>}
        <div class="cta__actions">
          <a class="btn btn--line-dark" href={url("/kelas/")}>{c.seeClass}</a>
        </div>
      </div>
      <ul class="facts facts--night">
        {
          c.after.map((x) => (
            <li>
              <Icon name={x.icon} size={24} />
              <div>
                <h3>{x.title}</h3>
                <p>{x.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec--l" aria-labelledby="towo-title">
    <div class="container">
      <div class="frame">
        <Logo part="mark" class="ornament" />
        <div class="std-head">
          <h2 id="towo-title">{c.woTitle}</h2>
          <p class="sec-lead">{c.woLead}</p>
        </div>
        <a class="btn" href={V2("/layanan/")}>{c.woCta}</a>
      </div>
    </div>
  </section>

  <section id="membership" class="sec band" aria-labelledby="members-title">
    <div class="container">
      <div class="pkg-head">
        <h2 id="members-title">{c.memTitle}</h2>
        <p>{c.memLead}</p>
      </div>
      <div class="members" tabindex="0" role="region" aria-label={c.memRegion}>
        <table>
          <caption class="visually-hidden">{c.memCaption}</caption>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">{c.feature}</span></th>
              {MEMBERSHIP.tiers.map((t) => <th scope="col">{t}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              MEMBERSHIP.rows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  {r.values.map((v) => (
                    <td>
                      {v === true && <Icon name="check" size={22} label={c.yes} />}
                      {(v === false || v === null) && (
                        <span class="members__no">
                          <Icon name="remove" size={20} label={c.no} />
                        </span>
                      )}
                      {typeof v === "string" && v}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <a class="btn btn--quiet members__cta" href={PLAY_STORE_URL} rel="noopener" data-track="play:v2-membership">{c.memCta}</a>
    </div>
  </section>

  <section id="faq" class="sec" aria-labelledby="faq-title">
    <div class="container faq">
      <div class="faq__aside">
        <h2 id="faq-title">Yang sering ditanyakan</h2>
      </div>
      <div class="faq__list">
        {
          FAQ.map((f) => (
            <details>
              <summary>
                {f.q}
                <Icon name="add" size={22} />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta sec" aria-labelledby="dl-title">
    <div class="container cta__inner">
      <div>
        <h2 id="dl-title">{dl.title}</h2>
        <p class="sec-lead">{dl.body}</p>
        <div class="cta__actions">
          <a class="btn btn--on-dark" href={PLAY_STORE_URL} rel="noopener" data-track="play:v2-taaruf-end">
            <Icon name="google-play" size={18} />Unduh di Google Play
          </a>
        </div>
      </div>
      <div class="dl-qr">
        <div class="dl-qr__code" set:html={qr} role="img" aria-label="Kode QR menuju Mahabbati di Google Play" />
        <p>{dl.qr}</p>
      </div>
    </div>
  </section>
</V2Layout>

<script>
  import "../../scripts/ghost.ts";
  import "../../scripts/photo-lock.ts";
</script>
