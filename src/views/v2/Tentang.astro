---
import V2Layout from "../../layouts/V2.astro";
import CtaBand from "../../components/v2/CtaBand.astro";
import { CREDITS } from "../../data/images";
import { WA, EMAIL, ADDRESS, INSTAGRAM_URL, url } from "../../data/site";
import { V2, WA_HREF, V2_PHOTOS } from "../../data/v2";

const PARTS = [
  {
    title: "Wedding organizer syar’i",
    body: "Paket khitbah, akad, akad di masjid, dan walimah, diurus satu tim dari persiapan sampai hari H.",
    href: V2("/layanan/"),
    cta: "Lihat layanan dan paket",
  },
  {
    title: "Kelas pranikah",
    body: "Kelas bersama asatidz Mahabbati. Paket Akad dan Masjid Akad sudah termasuk 4 sesi via Zoom.",
    href: url("/kelas/"),
    cta: "Lihat kelas pranikah",
  },
  {
    title: "Aplikasi ta’aruf",
    body: "Ta’aruf yang aman: profil terverifikasi, dan foto muslimah hanya ditinjau admin wanita.",
    href: url("/aplikasi/"),
    cta: "Kenali aplikasinya",
  },
];
const credits = V2_PHOTOS.filter((p) => CREDITS[p]).map((p) => ({ name: p, href: CREDITS[p] }));
---

<V2Layout
  title="Tentang Kami | Mahabbati Wedding Organizer Syar’i"
  description="Mahabbati menyatukan wedding organizer syar’i, kelas pranikah, dan aplikasi ta’aruf. Alamat dan kontak tim WO di Jakarta."
  current="tentang"
>
  <nav class="crumbs container" aria-label="Breadcrumb">
    <ol>
      <li><a href={V2("/")}>Beranda</a></li>
      <li aria-current="page">Tentang Kami</li>
    </ol>
  </nav>

  <header class="page-head container">
    <h1>Menuju janji suci, bersama</h1>
    <p class="sec-lead">
      Mahabbati menyatukan bekal ilmu, pertemuan yang aman, dan acara pernikahan yang tertata.
    </p>
  </header>

  <section class="sec--s" aria-labelledby="parts-title">
    <div class="container">
      <h2 id="parts-title" class="visually-hidden">Tiga bagian Mahabbati</h2>
      <ul class="parts">
        {
          PARTS.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <div>
                <p>{p.body}</p>
                <a class="text-link" href={p.href}>{p.cta}</a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sec band" aria-labelledby="kontak-title">
    <div class="container">
      <h2 id="kontak-title">Kantor dan kontak</h2>
      <div class="contact-grid">
        <div>
          <h3>Alamat</h3>
          <address>{ADDRESS}</address>
        </div>
        <div>
          <h3>WhatsApp tim WO</h3>
          <p><a href={WA_HREF} rel="noopener">{WA.wo.label}</a></p>
        </div>
        <div>
          <h3>Email dan Instagram</h3>
          <p><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
          <p><a href={INSTAGRAM_URL} rel="noopener">@mahabbati_official</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec--s" id="kredit-foto" aria-labelledby="kredit-title">
    <div class="container">
      <h2 id="kredit-title">Kredit foto</h2>
      <p class="sec-lead">
        Foto di halaman ini adalah ilustrasi dari Unsplash, bukan dokumentasi acara Mahabbati.
      </p>
      <ul class="credits">
        {credits.map((c) => <li><a href={c.href} rel="noopener">{c.href.replace("https://", "")}</a></li>)}
      </ul>
    </div>
  </section>

  <CtaBand />
</V2Layout>
