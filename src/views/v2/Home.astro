---
import V2Layout from "../../layouts/V2.astro";
import Icon from "../../components/Icon.astro";
import Logo from "../../components/Logo.astro";
import PackageList from "../../components/v2/PackageList.astro";
import CtaBand from "../../components/v2/CtaBand.astro";
import Moments from "../../components/v2/Moments.astro";
import { Image } from "astro:assets";
import { photo } from "../../data/images";
import { INSTAGRAM_URL } from "../../data/site";
import { WA_HREF, STANDARDS, PORTFOLIO, FAQ } from "../../data/v2";
---

<V2Layout
  title="Mahabbati Wedding Organizer Syar’i Jakarta | Khitbah, Akad, Walimah"
  description="Wedding organizer syar’i di Jakarta untuk khitbah, akad, dan walimah. Paket mulai Rp15 jt dengan harga per tingkat tertulis. Konsultasi via WhatsApp."
  overHero
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <Image
        src={photo("v2-walimah-tent")}
        alt="Tenda walimah di taman dengan tirai bermotif geometris, lampu gantung, dan meja tamu berlapis kain plum."
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="container">
      <div class="hero__copy">
        <h1 id="hero-title">Menyempurnakan separuh agama dengan indah</h1>
        <span class="hero__rule" aria-hidden="true"></span>
        <p class="hero__lead">Wedding organizer syar’i di Jakarta, dari khitbah sampai walimah.</p>
        <div class="hero__actions">
          <a class="btn" href={WA_HREF} rel="noopener">
            <Icon name="whatsapp" size={20} />Konsultasi via WhatsApp
          </a>
          <a class="btn btn--quiet" href="#paket">Lihat paket dan harga</a>
        </div>
      </div>
    </div>
  </section>

  <Moments />

  <section class="sec band" id="paket" aria-labelledby="paket-title">
    <div class="container">
      <div class="pkg-head">
        <h2 id="paket-title">Paket dan harga, tertulis sejak awal</h2>
        <p>Setiap paket punya beberapa tingkat. Pilih tingkatnya di halaman paket, lalu kirim lewat WhatsApp.</p>
      </div>
      <PackageList />
    </div>
  </section>

  <section class="sec--l" id="kenapa" aria-labelledby="kenapa-title">
    <div class="container">
      <div class="frame">
        <Logo part="mark" class="ornament" />
        <div class="std-head">
          <h2 id="kenapa-title">Indah di mata tamu, tenang di hati keluarga</h2>
          <p class="sec-lead">Yang kami jaga di setiap acara, supaya kalian tahu persis apa yang bisa diharapkan.</p>
        </div>
        <ul class="std">
          {
            STANDARDS.map((s) => (
              <li>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="sec band" id="portofolio" aria-labelledby="pf-title">
    <div class="container">
      <div class="pf-head">
        <div>
          <h2 id="pf-title">Suasana yang bisa kalian bayangkan</h2>
          <p class="pf-note">
            Foto ilustrasi dari Unsplash, bukan dokumentasi acara Mahabbati. Dokumentasi acara kami bisa kalian lihat saat konsultasi.
          </p>
        </div>
        <div class="pf-nav">
          <button type="button" class="round-btn" data-rail-prev aria-controls="pf-rail">
            <Icon name="chevron_left" size={24} /><span class="visually-hidden">Foto sebelumnya</span>
          </button>
          <button type="button" class="round-btn" data-rail-next aria-controls="pf-rail">
            <Icon name="chevron_right" size={24} /><span class="visually-hidden">Foto berikutnya</span>
          </button>
        </div>
      </div>
      <div class="rail" id="pf-rail" data-rail tabindex="0" role="region" aria-label="Foto suasana, geser ke samping">
        <ul>
          {
            PORTFOLIO.map((f) => (
              <li>
                <figure>
                  <Image src={photo(f.photo)} alt={f.alt} widths={[480, 720, 960]} sizes="(max-width: 40rem) 80vw, 560px" />
                  <figcaption>{f.caption}</figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="sec story" id="testimoni" aria-labelledby="testi-title">
    <div class="container">
      <h2 id="testi-title">Cerita pasangan</h2>
      <p class="story__names" aria-hidden="true">F<span class="story__amp">&amp;</span>N</p>
      <p class="story__text">
        <span class="visually-hidden">F dan N: </span>Bertemu lewat aplikasi Mahabbati, lalu menikah bersama WO Mahabbati.
      </p>
      <p class="story__src">
        Kisah yang dibagikan di <a href={INSTAGRAM_URL} rel="noopener">Instagram @mahabbati_official</a>, Oktober 2026.
      </p>
    </div>
  </section>

  <section class="sec band" id="faq" aria-labelledby="faq-title">
    <div class="container faq">
      <div class="faq__aside">
        <h2 id="faq-title">Yang sering ditanyakan</h2>
        <p>Pertanyaan lain soal tanggal, tempat, atau menu bisa langsung ditanyakan ke tim WO.</p>
        <a class="text-link" href={WA_HREF} rel="noopener">Tanya lewat WhatsApp</a>
      </div>
      <div class="faq__list">
        {
          FAQ.map((f) => (
            <details>
              <summary>
                {f.q}
                <Icon name="add" size={22} />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</V2Layout>
