---
import { url } from "../data/site";
import { langOf, path, htmlLang, ogLocale, LANGS, LANG_META, type Route } from "../i18n/lang";
import { ui } from "../i18n/ui";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getImage } from "astro:assets";
import { photo } from "../data/images";
import { PLAY_STORE_URL, INSTAGRAM_URL, EMAIL } from "../data/site";
import serifWoff2 from "@fontsource/libre-baskerville/files/libre-baskerville-latin-400-normal.woff2?url";
import sansWoff2 from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description: string;
  current?: Route;
  /** Detail pages: the slug shared by both languages. */
  slug?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>[];
}
const { title, description, current = "home", slug, ogImage = "hero-akad", jsonLd = [] } = Astro.props;
const lang = langOf(Astro.url);
const other = lang === "en" ? "id" : "en";
const alt = { id: new URL(path("id", current, slug), Astro.site), en: new URL(path("en", current, slug), Astro.site) };
// The 404 page has no twin, so its language menu leads to each home page.
const alternates = Object.fromEntries(LANGS.map((l) => [l, current === "404" ? path(l, "home") : path(l, current, slug)])) as Record<(typeof LANGS)[number], string>;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: photo(ogImage), width: 1200, height: 630, fit: "cover", format: "jpg" });
const ogUrl = new URL(og.src, Astro.site);

const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Mahabbati",
  url: "https://mahabbati.com",
  email: EMAIL,
  sameAs: [INSTAGRAM_URL, PLAY_STORE_URL],
};
---

<!doctype html>
<html lang={htmlLang[lang]} dir={LANG_META[lang].dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {current === "404" ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {current !== "404" && <link rel="alternate" hreflang="id" href={alt.id} />}
    {current !== "404" && <link rel="alternate" hreflang="en" href={alt.en} />}
    {current !== "404" && <link rel="alternate" hreflang="x-default" href={alt.id} />}
    <meta name="theme-color" content="#FAFAFC" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="preload" href={serifWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansWoff2} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta property="og:site_name" content="Mahabbati" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <script type="application/ld+json" set:html={JSON.stringify([org, ...jsonLd])} />
  </head>
  <body>
    <a class="skip-link" href="#konten">{ui(lang).skip}</a>
    <Header current={current} alternates={alternates} />
    <main id="konten" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <div class="cursor-label" aria-hidden="true" data-cursor-label></div>
    <script>
      import "../scripts/base.ts";
    </script>
  </body>
</html>
