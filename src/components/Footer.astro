---
import { langOf, path } from "../i18n/lang";
import { ui } from "../i18n/ui";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import {
  WA,
  waLink,
  EMAIL,
  INSTAGRAM_URL,
  ADDRESS,
  TERMS_URL,
  PRIVACY_URL,
  DATA_DELETION_URL,
  woGreeting,
} from "../data/site";
import { needLabel } from "../data/packages";
const year = new Date().getFullYear();
const lang = langOf(Astro.url);
const u = ui(lang);
const svc = (need: "lengkap" | "akad" | "masjid" | "walimah" | "khitbah") => `${path(lang, "layanan")}?kebutuhan=${need}`;
---

<footer class="site-footer chapter-night on-dark">
  <div class="wrap">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo part="lockup" class="site-footer__logo" />
        <p>{u.footer.brand}</p>
      </div>

      <nav aria-label={u.footer.nav} class="site-footer__nav">
        <div>
          <h2>{u.footer.services}</h2>
          <ul>
            {(["lengkap", "akad", "masjid", "walimah", "khitbah"] as const).map((n) => <li><a href={svc(n)}>{needLabel(n, lang)}</a></li>)}
            <li><a href={path(lang, "tempat")}>{u.footer.venues}</a></li>
          </ul>
        </div>
        <div>
          <h2>Mahabbati</h2>
          <ul>
            <li><a href={path(lang, "kelas")}>{u.nav.kelas}</a></li>
            <li><a href={path(lang, "cerita")}>{u.footer.stories}</a></li>
            <li><a href={path(lang, "aplikasi")}>{u.nav.aplikasi}</a></li>
            <li><a href={path(lang, "aplikasi", undefined, "membership")}>Membership</a></li>
            <li><a href={path(lang, "tentang")}>{u.footer.about}</a></li>
          </ul>
        </div>
        <div>
          <h2>{u.footer.contact}</h2>
          <ul class="site-footer__contact">
            <li>
              <a href={waLink(WA.wo.number, woGreeting(lang))} rel="noopener">
                <Icon name="whatsapp" size={18} /><span>{u.footer.woLine} <span class="num">{WA.wo.label}</span></span>
              </a>
            </li>
            <li>
              <a href={waLink(WA.ikhwan.number)} rel="noopener">
                <Icon name="whatsapp" size={18} /><span>{u.footer.ikhwan} <span class="num">{WA.ikhwan.label}</span></span>
              </a>
            </li>
            <li>
              <a href={waLink(WA.akhwat.number)} rel="noopener">
                <Icon name="whatsapp" size={18} /><span>{u.footer.akhwat} <span class="num">{WA.akhwat.label}</span></span>
              </a>
            </li>
            <li>
              <a href={`mailto:${EMAIL}`}><Icon name="mail" size={18} />{EMAIL}</a>
            </li>
            <li>
              <a href={INSTAGRAM_URL} rel="noopener"><Icon name="instagram" size={18} />@mahabbati_official</a>
            </li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__address"><Icon name="location_on" size={18} />{ADDRESS}</p>
      <ul>
        <li><a href={TERMS_URL}>{u.footer.terms}</a></li>
        <li><a href={PRIVACY_URL}>{u.footer.privacy}</a></li>
        <li><a href={DATA_DELETION_URL} rel="noopener">{u.footer.deletion}</a></li>
      </ul>
      <p class="site-footer__legal">© {year} Mahabbati. {u.footer.legal}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--s-9) var(--s-6);
  }
  .site-footer__top {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--s-8);
  }
  .site-footer__brand :global(.logo-lockup) {
    color: #fff;
  }
  .site-footer__brand p {
    margin-top: var(--s-4);
    max-width: 26ch;
    color: var(--lilac);
  }
  .site-footer__nav {
    display: grid;
    grid-template-columns: 1fr 1fr 1.6fr;
    gap: var(--s-6);
  }
  .site-footer h2 {
    font-family: var(--sans);
    font-size: var(--t-small);
    font-weight: 600;
    color: #fff;
    margin-bottom: var(--s-3);
  }
  .site-footer ul {
    list-style: none;
  }
  .site-footer li a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 40px;
    color: var(--haze);
    text-decoration: none;
    font-size: var(--t-small);
    transition: color var(--t-hover) ease;
  }
  .site-footer__contact a > span .num {
    display: block;
    color: var(--lilac);
  }
  .site-footer__contact li a {
    padding-block: 4px;
  }
  .site-footer li a:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3) var(--s-6);
    margin-top: var(--s-8);
    padding-top: var(--s-5);
    border-top: 1px solid rgba(201, 207, 242, 0.22);
    font-size: var(--t-micro);
    color: var(--lilac);
  }
  .site-footer__bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
  }
  .site-footer__bottom li a {
    font-size: var(--t-micro);
    min-height: 32px;
  }
  .site-footer__address {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
  }
  .site-footer__legal {
    margin-left: auto;
  }
  @media (max-width: 900px) {
    .site-footer__top {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-7);
    }
    .site-footer__nav {
      grid-template-columns: 1fr 1fr;
    }
    .site-footer__nav > div:last-child {
      grid-column: 1 / -1;
    }
    .site-footer__legal {
      margin-left: 0;
    }
  }
</style>
