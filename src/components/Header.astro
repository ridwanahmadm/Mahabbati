---
import { WA, waLink, woGreeting } from "../data/site";
import { langOf, path, LANGS, LANG_META, type Lang, type Route } from "../i18n/lang";
import { ui } from "../i18n/ui";
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";

interface Props {
  current?: Route;
  /** This page in every language. */
  alternates: Record<Lang, string>;
}
const { current = "home", alternates } = Astro.props;
const lang = langOf(Astro.url);
const u = ui(lang);
const keys = ["layanan", "tempat", "kelas", "cerita", "aplikasi"] as const;
const nav = keys.map((key) => ({ href: path(lang, key), label: u.nav[key], key }));
const wa = waLink(WA.wo.number, woGreeting(lang));
const langs = LANGS.map((l) => ({ code: l, href: alternates[l], name: LANG_META[l].native, current: l === lang }));
---

<header class="site-header" data-header>
  <div class="wrap site-header__bar">
    <a href={path(lang, "home")} class="site-header__home" aria-label={u.homeLabel}>
      <Logo part="lockup" />
    </a>

    <nav class="site-nav" aria-label={u.navMain}>
      <ul>
        {
          nav.map((n) => (
            <li>
              <a href={n.href} aria-current={n.key === current ? "page" : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="lang-menu" data-lang-menu>
      <button class="lang-menu__btn" type="button" aria-expanded="false" aria-controls="lang-list" data-lang-toggle>
        <Icon name="language" size={20} /><span>{u.langSwitch.button}</span>
      </button>
      <ul class="lang-menu__list" id="lang-list" hidden data-lang-list>
        {
          langs.map((l) => (
            <li>
              <a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.current ? "true" : undefined} data-track={`lang:${l.code}`}>
                <span>{l.name}</span>
                {l.current && <Icon name="check" size={20} />}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <a class="btn site-header__cta" href={wa} rel="noopener" data-track="wa:header">
      <Icon name="whatsapp" size={18} />{u.consult}
    </a>

    <button
      class="site-header__menu"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-toggle
    >
      <Icon name="menu" size={24} class="icon-open" />
      <Icon name="close" size={24} class="icon-close" />
      <span class="visually-hidden">{u.menu}</span>
    </button>
  </div>

  <div class="mobile-nav" id="mobile-nav" hidden>
    <nav aria-label={u.navMobile} class="wrap">
      <ul>
        <li><a href={path(lang, "home")}>{u.nav.home}</a></li>
        {
          nav.map((n) => (
            <li>
              <a href={n.href} aria-current={n.key === current ? "page" : undefined}>
                {n.label}
              </a>
            </li>
          ))
        }

      </ul>
      <p class="mobile-nav__lang-title"><Icon name="language" size={20} />{u.langSwitch.button}</p>
      <ul class="mobile-nav__langs">
        {
          langs.map((l) => (
            <li>
              <a href={l.href} hreflang={l.code} lang={l.code} aria-current={l.current ? "true" : undefined}>{l.name}</a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--wa" href={wa} rel="noopener" data-track="wa:menu"><Icon name="whatsapp" size={20} />{u.consultWa}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ground);
    transition: box-shadow var(--t-ui) ease;
  }
  .site-header:global(.is-scrolled) {
    box-shadow: 0 1px 0 var(--line);
  }
  .site-header__bar {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    height: var(--header-h);
  }
  .site-header__home {
    display: inline-flex;
    text-decoration: none;
    padding: 6px 0;
  }
  .site-nav {
    margin-left: auto;
  }
  .site-nav ul {
    display: flex;
    gap: var(--s-2);
    list-style: none;
  }
  .site-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--s-3);
    border-radius: var(--r-s);
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--t-hover) ease, background-color var(--t-hover) ease;
  }
  .site-nav a:hover {
    color: var(--ink);
    background: var(--mist);
  }
  .site-nav a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }
  .lang-menu {
    position: relative;
  }
  .lang-menu__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 var(--s-3);
    border: 0;
    border-radius: var(--r-s);
    background: transparent;
    font: inherit;
    font-size: var(--t-small);
    font-weight: 500;
    color: var(--ink-2);
    cursor: pointer;
    transition: color var(--t-hover) ease, background-color var(--t-hover) ease;
  }
  .lang-menu__btn span {
    text-decoration: underline;
    text-decoration-color: var(--lilac);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.4em;
  }
  .lang-menu__btn:hover,
  .lang-menu__btn[aria-expanded="true"] {
    color: var(--ink);
    background: var(--mist);
  }
  .lang-menu__list {
    position: absolute;
    top: calc(100% + 8px);
    inset-inline-end: 0;
    z-index: 60;
    min-width: 240px;
    margin: 0;
    padding: var(--s-2);
    list-style: none;
    border-radius: var(--r-l);
    background: var(--paper);
    box-shadow: 0 18px 48px rgb(51 50 74 / 0.16), 0 0 0 1px var(--line);
  }
  .lang-menu__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-height: 48px;
    padding: 0 var(--s-4);
    border-radius: var(--r-m);
    font-size: 1rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .lang-menu__list a:hover {
    background: var(--mist);
  }
  .lang-menu__list a[aria-current="true"] {
    font-weight: 600;
    color: var(--accent-ink);
  }
  .mobile-nav__lang-title {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-2);
    font-size: var(--t-small);
    font-weight: 600;
    color: var(--ink-2);
  }
  .mobile-nav__langs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  .mobile-nav .mobile-nav__langs a {
    display: inline-flex;
    min-height: 44px;
    padding: 0 var(--s-4);
    border: 0;
    border-radius: 999px;
    background: var(--mist);
    font-family: var(--sans);
    font-size: var(--t-small);
    font-weight: 600;
  }
  .mobile-nav .mobile-nav__langs a[aria-current="true"] {
    background: var(--brand);
    color: #fff;
  }
  .site-header__cta {
    min-height: 44px;
    padding-inline: var(--s-4);
    font-size: var(--t-small);
  }
  .site-header__menu {
    display: none;
    margin-left: auto;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 0;
    border-radius: var(--r-s);
    background: var(--mist);
    color: var(--ink);
  }
  .site-header__menu :global(.icon-close) {
    display: none;
  }
  .site-header__menu[aria-expanded="true"] :global(.icon-open) {
    display: none;
  }
  .site-header__menu[aria-expanded="true"] :global(.icon-close) {
    display: block;
  }
  .mobile-nav {
    border-top: 1px solid var(--line);
    background: var(--ground);
    padding-block: var(--s-4) var(--s-6);
  }
  .mobile-nav ul {
    list-style: none;
    margin-bottom: var(--s-5);
  }
  .mobile-nav li a {
    display: flex;
    align-items: center;
    min-height: 52px;
    font-family: var(--serif);
    font-size: 1.375rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .mobile-nav li a[aria-current="page"] {
    color: var(--accent-ink);
  }
  .mobile-nav .btn {
    width: 100%;
  }
  @media (max-width: 1200px) {
    .site-nav,
    .site-header__cta,
    .lang-menu {
      display: none;
    }
    .site-header__menu {
      display: grid;
    }
  }
  @media (max-width: 720px) {
    .site-header :global(.logo-lockup__mark) {
      width: 40px;
    }
    .site-header :global(.logo-lockup__word) {
      width: 100px;
    }
  }
</style>
