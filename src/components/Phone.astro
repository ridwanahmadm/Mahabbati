---
// A real app screen in a light device frame. Screens come from the Mahabbati Figma file.
// The frame follows each screenshot's own aspect ratio, so nothing is cropped or stretched.
import { Image } from "astro:assets";
import { screen } from "../data/images";

interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  loading?: "lazy" | "eager";
}
const { src, alt, class: cls, width = 320, loading = "lazy" } = Astro.props;
const img = screen(src);
const ratio = img.width / img.height;
// Corner radius as a share of the width, converted for the height so the corner stays round.
// 14% covers the device corners baked into the screenshots (up to 13.4% on kandidat and ai).
const corner = (pct: number) => `${pct}% / ${(pct * ratio).toFixed(2)}%`;
---

<figure class:list={["phone", cls]} style={`--w:${width}px; --ar:${img.width} / ${img.height}; --r-outer:${corner(16)}; --r-inner:${corner(14)}`}>
  <Image
    src={img}
    alt={alt}
    widths={[width, width * 2]}
    sizes={`${width}px`}
    loading={loading}
    decoding="async"
  />
</figure>

<style>
  .phone {
    flex: 0 1 auto;
    align-self: start;
    min-width: 0;
    width: min(var(--w), 100%);
    padding: 8px;
    border-radius: var(--r-outer);
    background: #fff;
    box-shadow: var(--shadow-phone), inset 0 0 0 1px var(--line);
  }
  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--ar);
    border-radius: var(--r-inner);
  }
</style>
