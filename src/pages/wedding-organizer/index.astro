---
import { url } from "../../data/site";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Faq from "../../components/Faq.astro";
import { Image } from "astro:assets";
import { photo } from "../../data/images";
import { PACKAGES, WO_STEPS } from "../../data/packages";
import { WO_FAQ } from "../../data/content";
import { WA, waLink, WO_GREETING, PROOF, rupiahShort } from "../../data/site";

const wa = waLink(WA.wo.number, WO_GREETING);

// DUMMY: isi perbandingan mengikuti contoh rincian paket di src/data/packages.ts.
const compare: { label: string; values: (string | boolean)[] }[] = [
  { label: "Jumlah tamu", values: ["Mengikuti vendormu", "50 sampai 200", "200 sampai 1.000"] },
  { label: "Catering", values: [false, "100 pax", "300 atau 500 pax"] },
  { label: "Dekorasi", values: [false, "Akad dan pelaminan", "Pelaminan, akad, gerbang"] },
  { label: "MUA dan busana", values: [false, "1 tampilan", "Akad dan resepsi"] },
  { label: "Dokumentasi", values: [false, "Foto 6 jam", "Foto dan video"] },
  { label: "Ustadz pemateri", values: [false, true, true] },
  { label: "Wedding planner dan crew", values: ["6 crew", "4 crew", "10 sampai 14 crew"] },
  { label: "Technical meeting", values: ["2 kali", true, true] },
];
const service = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Wedding Organizer Mahabbati",
  serviceType: "Wedding organizer syar'i",
  provider: { "@type": "Organization", name: "Mahabbati" },
  offers: PACKAGES.map((p) => ({
    "@type": "Offer",
    name: p.name,
    priceCurrency: "IDR",
    price: p.priceFrom,
    url: `https://mahabbati.com/wedding-organizer/${p.slug}/`,
  })),
};
---

<Base
  title="Wedding Organizer syar'i | Mahabbati"
  description="Wedding Organizer syar'i dari Mahabbati: vendor terkurasi, ustadz pemateri, rincian paket yang jelas. Paket mulai Rp1,5 jt."
  current="wo"
  ogImage="wo-hero"
  jsonLd={[service]}
>
  <section class="wo-hero wrap" aria-labelledby="wo-title">
    <div class="wo-hero__copy">
      <h1 id="wo-title" class="t-display">Walimah yang tenang, sesuai syariat.</h1>
      <p class="t-lead">
        Vendor terkurasi, ustadz pemateri, dan tim yang memegang kendali di hari H. Paket mulai Rp1,5 jt.
      </p>
      <div class="wo-hero__ctas">
        <a class="btn" href="#paket">Lihat paket</a>
        <a class="btn btn--outline" href={wa} rel="noopener" data-track="wa:wo-hero">
          <Icon name="whatsapp" size={20} />Konsultasi via WhatsApp
        </a>
      </div>
      <p class="wo-hero__proof"><strong class="num">{PROOF.couples}</strong> pasangan sudah menikah bersama tim kami.</p>
    </div>
    <figure class="wo-hero__photo" data-shutter>
      <Image
        src={photo("wo-hero")}
        alt="Pengantin berkebaya putih dan bersiger berdiri di pelaminan berhias bunga putih."
        widths={[480, 720, 960, 1280]}
        sizes="(max-width: 900px) 92vw, 42vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </section>

  <section class="why section chapter-mist" aria-labelledby="why-title">
    <div class="wrap why__grid">
      <div class="why__photos" aria-hidden="true">
        <figure class="photo why__p1" data-reveal="mask">
          <Image src={photo("wo-doa")} alt="" widths={[480, 720, 960]} sizes="(max-width: 900px) 60vw, 26vw" />
        </figure>
        <figure class="photo why__p2" data-reveal="mask">
          <Image src={photo("wo-mua")} alt="" widths={[360, 540, 720]} sizes="(max-width: 900px) 40vw, 18vw" />
        </figure>
      </div>
      <div class="why__copy">
        <h2 id="why-title" class="t-h2">Supaya hari itu tetap khidmat.</h2>
        <dl class="why__list">
          <div>
            <dt>Vendor dikurasi</dt>
            <dd>Setiap vendor melewati kurasi agar akad dan walimah berjalan sesuai syariat Islam.</dd>
          </div>
          <div>
            <!-- DUMMY: konfirmasi ke tim WO -->
            <dt>Ustadz pemateri</dt>
            <dd>Khutbah nikah sebelum ijab qabul dan tausiyah singkat untuk kedua keluarga.</dd>
          </div>
          <div>
            <!-- DUMMY: konfirmasi ke tim WO -->
            <dt>Rincian tertulis sebelum DP</dt>
            <dd>Isi paket dan harga ada di penawaran resmi, sehingga kamu tahu persis apa yang dibayar.</dd>
          </div>
          <div>
            <!-- DUMMY: konfirmasi ke tim WO -->
            <dt>Area tamu bisa dipisah</dt>
            <dd>Penataan area tamu pria dan wanita, bila keluarga menghendaki.</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <section id="paket" class="pk section" aria-labelledby="pk-title">
    <div class="wrap">
      <div class="pk__head">
        <h2 id="pk-title" class="t-h2">Pilih paketnya.</h2>
        <p class="t-lead">Semua harga adalah harga mulai. Buka paketnya untuk melihat rincian dan menghitung estimasi sesuai jumlah tamu.</p>
      </div>

      <ul class="pk__list" data-preview-list>
        {
          PACKAGES.map((p, i) => (
            <li class="pk__row" data-preview-index={i}>
              <figure class="pk__thumb photo" aria-hidden="true">
                <Image src={photo(p.photo)} alt="" widths={[320, 480]} sizes="40vw" />
              </figure>
              <div class="pk__name">
                <h3>
                  <a href={url(`/wedding-organizer/${p.slug}/`)} class="pk__link">
                    {p.name}
                  </a>
                </h3>
                <p>{p.promise}</p>
              </div>
              <p class="pk__for">{p.forWho}</p>
              <p class="pk__price">
                <span>mulai</span>
                <strong class="num">{rupiahShort(p.priceFrom)}</strong>
              </p>
              <span class="pk__go" aria-hidden="true">
                <Icon name="arrow_outward" size={28} />
              </span>
            </li>
          ))
        }
      </ul>

      <div class="pk__preview" aria-hidden="true" data-preview>
        {
          PACKAGES.map((p) => (
            <Image src={photo(p.photo)} alt="" widths={[480, 720]} sizes="340px" class="pk__preview-img" loading="lazy" />
          ))
        }
      </div>
    </div>
  </section>

  <section class="cmp section chapter-mist" aria-labelledby="cmp-title">
    <div class="wrap">
      <h2 id="cmp-title" class="t-h2">Bandingkan isi paket.</h2>
      <div class="cmp__pick" role="group" aria-label="Pilih paket yang ditampilkan" data-cmp-pick hidden>
        {
          PACKAGES.map((p, i) => (
            <button type="button" aria-pressed={i === 0 ? "true" : "false"} data-col={i}>
              {p.name.replace(" Wedding", "")}
            </button>
          ))
        }
      </div>
      <div class="cmp__scroll" tabindex="0" role="region" aria-label="Tabel perbandingan paket" data-lenis-prevent>
        <table class="cmp__table" data-cmp>
          <caption class="visually-hidden">Perbandingan isi paket Wedding Organizer</caption>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Isi paket</span></th>
              {
                PACKAGES.map((p) => (
                  <th scope="col">
                    <a href={url(`/wedding-organizer/${p.slug}/`)}>{p.name}</a>
                    <span class="cmp__from num">mulai {rupiahShort(p.priceFrom)}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              compare.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  {r.values.map((v) => (
                    <td>
                      {v === true && <Icon name="check" size={22} label="Termasuk" />}
                      {v === false && (
                        <span class="cmp__no">
                          <span aria-hidden="true">–</span>
                          <span class="visually-hidden">Tidak termasuk</span>
                        </span>
                      )}
                      {typeof v === "string" && v}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="cmp__note">Rincian bisa disesuaikan saat konsultasi. Harga final mengikuti penawaran resmi.</p>
    </div>
  </section>

  <section class="flow section" aria-labelledby="flow-title">
    <div class="wrap flow__grid">
      <h2 id="flow-title" class="t-h2">Dari obrolan pertama sampai hari H.</h2>
      <ol class="flow__list">
        {
          WO_STEPS.map((s, i) => (
            <li class="flow__step" data-reveal style={`--d:${i * 80}`}>
              <span class="flow__num num" aria-hidden="true">
                {i + 1}
              </span>
              <h3 class="t-h3">{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="story section chapter-night on-dark" aria-labelledby="story-title">
    <div class="wrap story__grid">
      <figure class="story__photo photo" data-reveal="mask">
        <Image src={photo("wo-melati")} alt="Pengantin berkerudung putih berhias roncean melati, kedua tangannya berhias henna." widths={[480, 720, 960]} sizes="(max-width: 900px) 80vw, 34vw" />
      </figure>
      <div>
        <h2 id="story-title" class="story__num">
          <span class="num">{PROOF.couples}</span>
          <span>pasangan sudah melangkah ke pelaminan bersama Wedding Organizer Mahabbati.</span>
        </h2>
        <figure class="story__quote">
          <blockquote>
            <p>"Dipertemukan melalui Mahabbati, kini melangkah bersama dalam ikatan pernikahan."</p>
          </blockquote>
          <figcaption>F &amp; N, Oktober 2026</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="wo-faq section" aria-labelledby="wofaq-title">
    <div class="wrap wo-faq__grid">
      <h2 id="wofaq-title" class="t-h2">Tanya jawab.</h2>
      <Faq items={WO_FAQ} id="faq-wo" />
    </div>
  </section>

  <section class="wo-cta section chapter-mist" aria-labelledby="wocta-title">
    <div class="wrap wo-cta__inner">
      <h2 id="wocta-title" class="t-h2">Ceritakan rencanamu, kami bantu hitung.</h2>
      <p class="t-lead">Kirim tanggal, kota, dan perkiraan jumlah tamu. Tim WO membalas lewat WhatsApp.</p>
      <a class="btn btn--wa" href={wa} rel="noopener" data-track="wa:wo-bottom">
        <Icon name="whatsapp" size={22} />Chat tim WO, {WA.wo.label}
      </a>
    </div>
  </section>
</Base>

<style>
  .wo-hero {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--s-8);
    align-items: center;
    padding-block: clamp(32px, 5vw, 72px) var(--s-9);
  }
  .wo-hero__copy .t-lead {
    margin-top: var(--s-5);
  }
  .wo-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .wo-hero__proof {
    margin-top: var(--s-6);
    color: var(--ink-2);
  }
  .wo-hero__proof strong {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--ink);
  }
  .wo-hero__photo {
    aspect-ratio: 4 / 5;
    border-radius: var(--r-l);
    overflow: clip;
    background: var(--haze);
  }
  .wo-hero__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .js .wo-hero__photo {
      animation: shutter 1200ms var(--ease-in-out) 100ms both;
    }
    .js .wo-hero__photo :global(img) {
      animation: settle 1400ms var(--ease-expo) 100ms both;
    }
  }
  @keyframes shutter {
    from {
      clip-path: inset(100% 0 0 0 round var(--r-l));
    }
    to {
      clip-path: inset(0 0 0 0 round var(--r-l));
    }
  }
  @keyframes settle {
    from {
      transform: scale(1.12);
    }
  }

  .why__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s-8);
    align-items: center;
  }
  .why__photos {
    position: relative;
    min-height: 560px;
  }
  .why__p1 {
    position: absolute;
    left: 0;
    top: 0;
    width: 74%;
    aspect-ratio: 3 / 2;
  }
  .why__p2 {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 48%;
    aspect-ratio: 4 / 5;
  }
  .why__list {
    display: grid;
    gap: var(--s-5);
    margin-top: var(--s-6);
  }
  .why__list dt {
    font-family: var(--serif);
    font-size: 1.25rem;
  }
  .why__list dd {
    margin-top: var(--s-1);
    color: var(--ink-2);
    max-width: 46ch;
  }

  .pk {
    position: relative;
  }
  .pk__head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--s-5) var(--s-7);
    align-items: end;
    margin-bottom: var(--s-7);
  }
  .pk__list {
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .pk__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 2fr) 48px;
    gap: var(--s-6);
    align-items: center;
    padding-block: var(--s-6);
    border-bottom: 1px solid var(--line);
    transition: background-color var(--t-ui) ease;
  }
  .pk__row:hover {
    background: var(--mist);
  }
  .pk__thumb {
    display: none;
  }
  .pk__name h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .pk__link {
    text-decoration: none;
  }
  .pk__link::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .pk__link:focus-visible {
    outline: none;
  }
  .pk__row:focus-within {
    outline: 2.5px solid var(--focus);
    outline-offset: 2px;
    border-radius: 6px;
  }
  .pk__name p {
    margin-top: var(--s-2);
    color: var(--ink-2);
  }
  .pk__for {
    color: var(--ink-2);
    font-size: var(--t-small);
  }
  .pk__price {
    display: grid;
    text-align: right;
  }
  .pk__price span {
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .pk__price strong {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.625rem;
  }
  .pk__go {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--haze);
    color: var(--brand);
    transition: background-color var(--t-ui) ease, color var(--t-ui) ease;
  }
  .pk__row:hover .pk__go {
    background: var(--brand);
    color: #fff;
  }
  .pk__preview {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 40;
    width: 300px;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-l);
    overflow: clip;
    pointer-events: none;
    opacity: 0;
    scale: 0.85;
    transition: opacity 220ms ease, scale 320ms var(--ease-out);
    box-shadow: var(--shadow-float);
  }
  .pk__preview:global(.is-on) {
    opacity: 1;
    scale: 1;
  }
  .pk__preview :global(.pk__preview-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    clip-path: inset(100% 0 0 0);
    transition: clip-path 520ms var(--ease-in-out);
  }
  .pk__preview :global(.pk__preview-img.is-active) {
    clip-path: inset(0 0 0 0);
    z-index: 1;
  }

  .cmp__scroll {
    margin-top: var(--s-7);
    overflow-x: auto;
    border-radius: var(--r-l);
    background: var(--paper);
  }
  .cmp__table {
    width: 100%;
    min-width: 720px;
    border-collapse: collapse;
  }
  .cmp__table th,
  .cmp__table td {
    padding: var(--s-4) var(--s-5);
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .cmp__table tbody tr:last-child > * {
    border-bottom: 0;
  }
  .cmp__table thead th {
    padding-block: var(--s-5);
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.25rem;
    width: 25%;
  }
  .cmp__table thead a {
    text-decoration: none;
  }
  .cmp__table thead a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .cmp__from {
    display: block;
    margin-top: 4px;
    font-family: var(--sans);
    font-size: var(--t-small);
    color: var(--ink-2);
  }
  .cmp__table tbody th {
    font-weight: 500;
  }
  .cmp__table td :global(.icon) {
    color: var(--success);
  }
  .cmp__no {
    color: var(--ink-3);
  }
  .cmp__pick {
    display: none;
  }
  @media (max-width: 700px) {
    .cmp__pick:not([hidden]) {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 6px;
      margin-top: var(--s-6);
      padding: 6px;
      border-radius: var(--r-m);
      background: var(--haze);
    }
    .cmp__pick button {
      min-height: 48px;
      border: 0;
      border-radius: 9px;
      background: transparent;
      font-weight: 600;
      font-size: var(--t-small);
      color: var(--ink);
    }
    .cmp__pick button[aria-pressed="true"] {
      background: var(--brand);
      color: #fff;
    }
    .cmp__table[data-show] {
      min-width: 0;
      table-layout: fixed;
    }
    .cmp__table[data-show] th,
    .cmp__table[data-show] td {
      width: auto;
    }
    .cmp__table[data-show] tbody th {
      width: 42%;
    }
    .cmp__table[data-show="0"] tr > :is(:nth-child(3), :nth-child(4)),
    .cmp__table[data-show="1"] tr > :is(:nth-child(2), :nth-child(4)),
    .cmp__table[data-show="2"] tr > :is(:nth-child(2), :nth-child(3)) {
      display: none;
    }
    .cmp__scroll {
      margin-top: var(--s-4);
    }
  }
  .cmp__note {
    margin-top: var(--s-4);
    font-size: var(--t-small);
    color: var(--ink-2);
  }

  .flow__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--s-8);
  }
  .flow__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-7) var(--s-6);
  }
  .flow__num {
    display: block;
    font-family: var(--serif);
    font-size: 3rem;
    line-height: 1;
    color: var(--accent);
  }
  .flow__step h3 {
    margin-top: var(--s-4);
  }
  .flow__step p {
    margin-top: var(--s-2);
    color: var(--ink-2);
    max-width: 34ch;
  }

  .story__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--s-8);
    align-items: center;
  }
  .story__photo {
    aspect-ratio: 4 / 5;
    max-width: 440px;
  }
  .story__num {
    display: grid;
    gap: var(--s-3);
    font-weight: 400;
  }
  .story__num .num {
    font-family: var(--serif);
    font-size: clamp(4.5rem, 3rem + 6vw, 8.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .story__num span:last-child {
    font-family: var(--serif);
    font-size: var(--t-h3);
    line-height: 1.3;
    color: var(--lilac);
    max-width: 24ch;
  }
  .story__quote {
    margin-top: var(--s-7);
  }
  .story__quote p {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--t-lead);
    color: #fff;
    max-width: 40ch;
  }
  .story__quote figcaption {
    margin-top: var(--s-3);
    font-size: var(--t-small);
    color: var(--lilac);
  }

  .wo-faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--s-8);
  }
  .wo-cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: start;
    gap: var(--s-5);
  }
  .wo-cta__inner .btn {
    white-space: normal;
    text-align: left;
    padding-block: var(--s-3);
  }

  @media (max-width: 900px) {
    .wo-hero,
    .why__grid,
    .pk__head,
    .flow__grid,
    .story__grid,
    .wo-faq__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }
    .why__photos {
      min-height: 380px;
      order: 2;
    }
    .pk__row {
      grid-template-columns: 96px 1fr;
      gap: var(--s-2) var(--s-4);
      align-items: start;
    }
    .pk__thumb {
      display: block;
      grid-row: span 3;
      aspect-ratio: 4 / 5;
      border-radius: var(--r-m);
    }
    .pk__price {
      text-align: left;
      grid-column: 2;
    }
    .pk__for {
      grid-column: 2;
    }
    .pk__go {
      display: none;
    }
    .pk__preview {
      display: none;
    }
    .flow__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import "../../scripts/preview.ts";

  // Phones: compare one package at a time instead of a sideways-scrolling table.
  const pick = document.querySelector<HTMLElement>("[data-cmp-pick]");
  const table = document.querySelector<HTMLTableElement>("[data-cmp]");
  if (pick && table) {
    pick.hidden = false;
    table.dataset.show = "0";
    pick.querySelectorAll<HTMLButtonElement>("button").forEach((b) =>
      b.addEventListener("click", () => {
        table.dataset.show = b.dataset.col;
        pick.querySelectorAll("button").forEach((o) => o.setAttribute("aria-pressed", String(o === b)));
      }),
    );
  }
</script>
