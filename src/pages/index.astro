---
import { url } from "../data/site";
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import Icon from "../components/Icon.astro";
import DownloadBlock from "../components/DownloadBlock.astro";
import { Image } from "astro:assets";
import { photo } from "../data/images";
import { JOURNEY } from "../data/content";
import { PROOF, PLAY_STORE_URL } from "../data/site";

const portrait = new Set(["taaruf", "nadzhor", "khitbah"]);
---

<Base
  title="Mahabbati | Ta'aruf syar'i sampai walimah"
  description="Mahabbati menemani perjalanan menuju nikah: ta'aruf yang aman lewat aplikasi, persiapan pranikah, sampai Wedding Organizer syar'i."
  current="home"
>
  <!-- Persimpangan: the fork between the two audiences, as a working homepage -->
  <section class="cross" aria-labelledby="cross-title">
    <div class="cross__intro wrap">
      <h1 id="cross-title" class="t-display">Dari ta'aruf hingga walimah.</h1>
      <p class="cross__ask">Kamu sedang di tahap mana?</p>
    </div>

    <div class="cross__stage" data-cross>
      <article class="cross__side cross__side--left" data-side="left" aria-labelledby="side-taaruf">
        <div class="cross__media">
          <Image
            class="cross__img cross__img--mono"
            src={photo("hero-taaruf")}
            alt="Seorang muslimah berkerudung biru muda dan seorang pria berdiri di balkon, menatap ke kejauhan."
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 900px) 100vw, 64vw"
            loading="eager"
            fetchpriority="high"
          />
          <Image
            class="cross__img cross__img--color"
            src={photo("hero-taaruf")}
            alt=""
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 900px) 100vw, 64vw"
            loading="eager"
          />
        </div>
        <div class="cross__text on-dark">
          <h2 id="side-taaruf" class="cross__title">Aku masih mencari.</h2>
          <p>Ta'aruf yang terarah dan aman. Semua profil terverifikasi, dan kuotamu kembali kalau pengajuan tak dibalas.</p>
          <a class="btn btn--light cross__cta" href={url("/taaruf/")}>Mulai ta'aruf</a>
        </div>
      </article>

      <article class="cross__side cross__side--right" data-side="right" aria-labelledby="side-walimah">
        <div class="cross__media">
          <Image
            class="cross__img cross__img--mono"
            src={photo("hero-walimah")}
            alt="Pengantin Sunda bersiger dan berhias roncean melati, bersanding dengan pengantin pria berpeci putih."
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 900px) 100vw, 64vw"
            loading="eager"
            fetchpriority="high"
          />
          <Image
            class="cross__img cross__img--color"
            src={photo("hero-walimah")}
            alt=""
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 900px) 100vw, 64vw"
            loading="eager"
          />
        </div>
        <div class="cross__text on-dark">
          <h2 id="side-walimah" class="cross__title">Kami siap menikah.</h2>
          <p>Wedding Organizer syar'i dengan vendor terkurasi dan ustadz pemateri. Paket mulai Rp1,5 jt.</p>
          <a class="btn btn--light cross__cta" href={url("/wedding-organizer/")}>Lihat paket WO</a>
        </div>
      </article>

      <div class="cross__seam" aria-hidden="true">
        <span class="cross__knot"><Logo part="mark" /></span>
      </div>
    </div>
  </section>

  <!-- Benang: the logo's handwritten line, drawn through the six stages -->
  <section class="journey section" aria-labelledby="journey-title" data-journey>
    <div class="wrap">
      <header class="journey__head">
        <h2 id="journey-title" class="t-h2">Dari "aku" menjadi "kami".</h2>
        <p class="t-lead">
          Enam tahap menuju nikah. Mahabbati menemanimu di setiap tahapnya, dari aplikasi di genggaman sampai hari
          walimah.
        </p>
      </header>

      <div class="journey__body" data-journey-body>
        <svg class="journey__thread" aria-hidden="true" focusable="false" data-thread>
          <path class="journey__path journey__path--base" />
          <path class="journey__path journey__path--ink" />
          <circle class="journey__nib" r="6" />
        </svg>

        <ol class="journey__list">
          {
            JOURNEY.map((s, i) => (
              <li class:list={["stage", i % 2 ? "stage--flip" : "", portrait.has(s.id) ? "stage--tall" : ""]} data-stage>
                <div class="stage__text">
                  <span class="stage__node" data-node aria-hidden="true">
                    {i + 1}
                  </span>
                  <h3 class="t-h3">
                    <span class="visually-hidden">Tahap {i + 1}: </span>
                    {s.name}
                  </h3>
                  <p class="stage__line">{s.line}</p>
                  <p class="stage__how">{s.how}</p>
                </div>
                <figure class="stage__photo photo" data-reveal="mask">
                  <Image
                    src={photo(s.photo)}
                    alt={s.alt}
                    widths={[480, 720, 960, 1280]}
                    sizes="(max-width: 900px) 92vw, 46vw"
                  />
                </figure>
              </li>
            ))
          }
        </ol>

        <div class="journey__end" data-journey-end>
          <div class="journey__mark" data-mark>
            <Logo part="mark" />
          </div>
          <p class="journey__close">Semua tahap ini ada di satu tempat.</p>
          <div class="journey__doors">
            <a class="btn" href={url("/taaruf/")}>Lihat cara kerja ta'aruf</a>
            <a class="btn btn--outline" href={url("/wedding-organizer/")}>Lihat paket WO</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bukti: only real, sourced figures -->
  <section class="proof section chapter-night on-dark" aria-labelledby="proof-title">
    <div class="wrap proof__grid">
      <div class="proof__copy">
        <h2 id="proof-title" class="proof__big">
          <span class="num">{PROOF.couples}</span>
          <span class="proof__big-label">pasangan sudah menikah lewat Wedding Organizer Mahabbati.</span>
        </h2>

        <figure class="proof__story">
          <blockquote>
            <p>"Dipertemukan melalui Mahabbati, kini melangkah bersama dalam ikatan pernikahan."</p>
          </blockquote>
          <figcaption>F &amp; N, kisah yang dibagikan di Instagram Mahabbati, Oktober 2026</figcaption>
        </figure>

        <dl class="proof__facts">
          <div>
            <dt>Rating Google Play</dt>
            <dd><span class="num">{PROOF.rating}</span><Icon name="star" fill size={20} /></dd>
          </div>
          <div>
            <dt>Komunitas Instagram</dt>
            <dd class="num">{PROOF.instagram}</dd>
          </div>
          <div>
            <dt>Kajian offline Jakarta</dt>
            <dd>Tiket habis</dd>
          </div>
        </dl>

        <figure class="proof__review">
          <blockquote>
            <p>"{PROOF.review.quote}"</p>
          </blockquote>
          <figcaption>{PROOF.review.by}, {PROOF.review.source}</figcaption>
        </figure>
      </div>

      <figure class="proof__photo photo" data-reveal="mask">
        <Image
          src={photo("walk")}
          alt="Pasangan pengantin berbaju putih dan bergamis gelap berjalan bergandengan di jalan setapak berpohon palem."
          widths={[480, 720, 960, 1280]}
          sizes="(max-width: 900px) 92vw, 40vw"
        />
      </figure>
    </div>
  </section>

  <DownloadBlock from="home" />
</Base>

<style>
  /* ---------- Persimpangan ---------- */
  .cross {
    display: flex;
    flex-direction: column;
    height: calc(100svh - var(--header-h));
    min-height: 620px;
    max-height: 1040px;
  }
  .cross__intro {
    flex: none;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-3) var(--s-6);
    padding-block: clamp(20px, 3vw, 40px) clamp(24px, 3.4vw, 48px);
  }
  .cross__intro h1 {
    font-size: clamp(2.375rem, 1.5rem + 2.7vw, 4.25rem);
  }
  .cross__ask {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--t-lead);
    color: var(--ink-2);
  }

  .cross__stage {
    --split: 50%;
    --pad: clamp(24px, 3.2vw, 56px);
    position: relative;
    flex: 1;
    min-height: 440px;
    overflow: clip;
    background: var(--night);
    isolation: isolate;
  }
  .cross__side {
    position: absolute;
    inset: 0;
  }
  .cross__side--left {
    clip-path: inset(0 calc(100% - var(--split)) 0 0);
  }
  .cross__side--right {
    clip-path: inset(0 0 0 var(--split));
  }
  .cross__media {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 58%;
    overflow: clip;
  }
  .cross__side--left .cross__media {
    left: 0;
  }
  .cross__side--right .cross__media {
    right: 0;
  }
  .cross__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cross__side--left .cross__img {
    object-position: 50% 30%;
  }
  .cross__side--right .cross__img {
    object-position: 50% 64%;
  }
  /* Brand-tinted resting state; the hovered side opens in full colour (cross.ts). */
  .cross__img--mono {
    filter: grayscale(1) contrast(1.08) brightness(0.86);
  }
  .cross__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--brand);
    mix-blend-mode: color;
    pointer-events: none;
  }
  .cross__img--color {
    z-index: 2;
    clip-path: circle(var(--r, 0px) at var(--cx, 50%) var(--cy, 60%));
  }
  .cross__media::before {
    /* text scrim, functional: keeps white text >= 4.5:1 on any photo */
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    background: linear-gradient(
      to top,
      rgba(34, 33, 54, 0.92) 0%,
      rgba(34, 33, 54, 0.82) 30%,
      rgba(34, 33, 54, 0.62) 50%,
      rgba(34, 33, 54, 0.28) 64%,
      rgba(34, 33, 54, 0) 76%
    );
    pointer-events: none;
  }
  .cross__text {
    position: absolute;
    z-index: 4;
    bottom: var(--pad);
    width: min(27rem, calc(38% - 2 * var(--pad)));
    color: #fff;
  }
  .cross__side--left .cross__text {
    left: var(--pad);
  }
  .cross__side--right .cross__text {
    right: var(--pad);
  }
  .cross__title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(2rem, 1.2rem + 2.4vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .cross__text p {
    margin-top: var(--s-3);
    color: var(--haze);
    max-width: 34ch;
  }
  .cross__cta {
    margin-top: var(--s-5);
  }
  /* The whole side is a target; the link stays the single accessible control.
     clip-path (desktop) and overflow:clip (mobile) keep the hit area inside its own side. */
  .cross__cta::after {
    content: "";
    position: absolute;
    inset: -200vmax;
  }
  .cross__seam {
    position: absolute;
    z-index: 5;
    top: 0;
    bottom: 0;
    left: var(--split);
    width: 2px;
    margin-left: -1px;
    background: var(--lilac);
    pointer-events: none;
  }
  .cross__knot {
    position: absolute;
    top: 0;
    left: 50%;
    display: grid;
    place-items: center;
    width: 112px;
    height: 64px;
    border-radius: 0 0 var(--r-l) var(--r-l);
    background: var(--ground);
    color: var(--brand);
    transform: translateX(-50%);
  }
  .cross__knot :global(.logo-mark) {
    width: 72px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .js .cross__side--left {
      animation: open-left 1100ms var(--ease-in-out) 120ms both;
    }
    .js .cross__side--right {
      animation: open-right 1100ms var(--ease-in-out) 120ms both;
    }
    .js .cross__text {
      animation: rise 700ms var(--ease-out) 620ms both;
    }
    .js .cross__seam {
      animation: seam 900ms var(--ease-expo) both;
    }
  }
  @keyframes open-left {
    from {
      clip-path: inset(0 50% 0 50%);
    }
  }
  @keyframes open-right {
    from {
      clip-path: inset(0 50% 0 50%);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @keyframes seam {
    from {
      transform: scaleY(0);
      transform-origin: top;
    }
  }

  @media (max-width: 900px) {
    .cross {
      height: auto;
      min-height: 0;
      max-height: none;
    }
    .cross__stage {
      height: auto;
      background: none;
      overflow: visible;
    }
    .cross__side {
      position: relative;
      height: clamp(420px, 66svh, 560px);
      clip-path: none !important;
      animation: none !important;
      overflow: clip;
    }
    .cross__media {
      width: 100%;
    }
    .cross__media::after,
    .cross__img--mono {
      display: none;
    }
    .cross__img--color {
      clip-path: none;
    }
    .cross__text {
      width: auto;
      left: var(--gutter) !important;
      right: var(--gutter) !important;
      bottom: var(--s-6);
    }
    .cross__seam {
      display: none;
    }
  }
  @media (hover: none) {
    .cross__media::after,
    .cross__img--mono {
      display: none;
    }
    .cross__img--color {
      clip-path: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cross__media::after {
      display: none;
    }
    .cross__img--color {
      clip-path: none;
    }
  }

  /* ---------- Benang ---------- */
  .journey__head {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--s-6) var(--s-8);
    align-items: end;
    margin-bottom: var(--s-9);
  }
  .journey__body {
    position: relative;
  }
  .journey__thread {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .journey__path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .journey__path--base {
    stroke: var(--haze);
    stroke-width: 2;
  }
  .journey__path--ink {
    stroke: var(--brand);
    stroke-width: 3.5;
  }
  .journey__nib {
    fill: var(--brand);
    opacity: 0;
  }
  .journey__list {
    position: relative;
    list-style: none;
    display: grid;
    gap: clamp(72px, 9vw, 140px);
  }
  .stage {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--s-5);
    align-items: center;
  }
  .stage__text {
    position: relative;
    grid-column: 2 / span 4;
    grid-row: 1;
  }
  .stage__photo {
    grid-column: 7 / span 6;
    grid-row: 1;
    aspect-ratio: 3 / 2;
  }
  .stage--tall .stage__photo {
    grid-column: 7 / span 5;
    aspect-ratio: 4 / 5;
  }
  .stage--flip .stage__text {
    grid-column: 8 / span 4;
  }
  .stage--flip .stage__photo {
    grid-column: 1 / span 6;
  }
  .stage--flip.stage--tall .stage__photo {
    grid-column: 2 / span 5;
  }
  .stage__node {
    position: absolute;
    top: 2px;
    left: -64px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--ground);
    box-shadow: inset 0 0 0 2px var(--lilac);
    color: var(--accent-ink);
    font-family: var(--serif);
    font-size: 1rem;
    font-variant-numeric: lining-nums;
    transition: background-color 300ms ease, color 300ms ease, box-shadow 300ms ease;
  }
  .stage__node:global(.is-on) {
    background: var(--brand);
    box-shadow: inset 0 0 0 2px var(--brand);
    color: #fff;
  }
  .stage__line {
    margin-top: var(--s-3);
    font-size: var(--t-lead);
    line-height: 1.5;
    color: var(--ink);
  }
  .stage__how {
    margin-top: var(--s-4);
    color: var(--ink-2);
    max-width: 36ch;
  }
  .journey__end {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
    padding-top: clamp(96px, 10vw, 160px);
  }
  .journey__mark {
    width: clamp(180px, 22vw, 280px);
    color: var(--brand);
    --wipe: 115%;
    -webkit-mask-image: linear-gradient(90deg, #000 calc(var(--wipe) - 15%), transparent var(--wipe));
    mask-image: linear-gradient(90deg, #000 calc(var(--wipe) - 15%), transparent var(--wipe));
  }
  .journey__close {
    margin-top: var(--s-6);
    font-family: var(--serif);
    font-size: var(--t-h3);
  }
  .journey__doors {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  @media (max-width: 900px) {
    .journey__head {
      grid-template-columns: minmax(0, 1fr);
      margin-bottom: var(--s-8);
    }
    .stage {
      grid-template-columns: minmax(0, 1fr);
      row-gap: var(--s-5);
    }
    .stage__text,
    .stage--flip .stage__text {
      grid-column: 1;
      grid-row: 1;
      padding: 0 0 0 64px;
    }
    .stage__photo,
    .stage--tall .stage__photo,
    .stage--flip .stage__photo,
    .stage--flip.stage--tall .stage__photo {
      grid-column: 1;
      grid-row: 2;
      margin-left: 64px;
      aspect-ratio: 4 / 3;
    }
    .stage__node {
      top: 0;
      left: 0;
    }
    .journey__end {
      justify-items: start;
      text-align: left;
      padding-left: 64px;
    }
    .journey__doors {
      justify-content: flex-start;
    }
  }

  /* ---------- Bukti ---------- */
  .proof__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--s-8);
    align-items: start;
  }
  .proof__big {
    display: grid;
    gap: var(--s-3);
    font-weight: 400;
  }
  .proof__big .num {
    font-family: var(--serif);
    font-size: clamp(5rem, 3rem + 8vw, 10rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: #fff;
  }
  .proof__big-label {
    font-family: var(--serif);
    font-size: var(--t-h3);
    line-height: 1.3;
    color: var(--lilac);
    max-width: 22ch;
  }
  .proof__story {
    margin-top: var(--s-7);
    max-width: 34rem;
  }
  .proof__story blockquote p {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--t-lead);
    line-height: 1.55;
    color: #fff;
  }
  .proof__story figcaption,
  .proof__review figcaption {
    margin-top: var(--s-3);
    font-size: var(--t-small);
    color: var(--lilac);
  }
  .proof__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5) var(--s-8);
    margin-top: var(--s-8);
    padding-top: var(--s-6);
    border-top: 1px solid rgba(201, 207, 242, 0.24);
  }
  .proof__facts dt {
    font-size: var(--t-small);
    color: var(--lilac);
  }
  .proof__facts dd {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 2px;
    font-family: var(--serif);
    font-size: 1.75rem;
    color: #fff;
  }
  .proof__facts dd :global(.icon) {
    color: var(--gold);
  }
  .proof__review {
    margin-top: var(--s-6);
  }
  .proof__review p {
    color: var(--haze);
  }
  .proof__photo {
    aspect-ratio: 2 / 3;
    margin-top: var(--s-6);
  }
  @media (max-width: 900px) {
    .proof__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .proof__photo {
      aspect-ratio: 4 / 5;
      max-width: 440px;
    }
  }
</style>

<script>
  import "../scripts/cross.ts";
  import "../scripts/journey.ts";
</script>
